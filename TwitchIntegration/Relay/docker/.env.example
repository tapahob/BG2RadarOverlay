# Copy to .env and fill in. Never commit the filled-in copy - three of these are secrets.

# The domain pointing at this host. Must resolve here already, or the certificate can't be issued.
RELAY_DOMAIN=relay.example.com


# ---- Extension Secret ----
# Dev Console -> Extensions -> your extension -> Manage -> Secret. Base64, as Twitch shows it.
# Signs every JWT the Extension deals with. Without it, Bits purchases and spending tokens are
# both off.
TWITCH_EXTENSION_SECRET=

# ---- Extension client id / secret ----
# The SAME Manage page, but a different pair of fields from the Secret above - easy to mix up.
# Lets the relay read the token prices each streamer saved in their config.html.
TWITCH_EXTENSION_CLIENT_ID=
TWITCH_EXTENSION_CLIENT_SECRET=

# ---- OAuth Application (Channel Points only) ----
# Dev Console -> register a new *Application*, not another Extension. Leave both blank to run
# Bits-only. Set the Application's OAuth Redirect URL to exactly:
#     https://<RELAY_DOMAIN>/oauth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=


# ---- Only for docker-compose.existing-proxy.yml ----
# Where the relay listens for your reverse proxy. Keep it on loopback.
#RELAY_BIND=127.0.0.1:5080
# Where its data lives on the host.
#RELAY_DATA_PATH=/var/lib/twitch-relay
# Who owns that directory - `stat -c %u:%g /var/lib/twitch-relay`. Migrating from a host install,
# set these to the account that already owns the data so nothing has to be chowned.
#RELAY_UID=1654
#RELAY_GID=1654
