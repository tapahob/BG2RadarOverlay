<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Top-level statements put Program in the global namespace as an internal class;
         WebApplicationFactory in the tests needs to name it as its entry point. -->
    <InternalsVisibleTo Include="TwitchRelay.Tests" />
  </ItemGroup>

</Project>
