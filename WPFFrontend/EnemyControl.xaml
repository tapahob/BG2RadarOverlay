<UserControl x:Name="UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
             xmlns:wpffrontend="clr-namespace:WPFFrontend"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:bg="clr-namespace:BGOverlay;assembly=BGOverlayAPI"
    x:Class="WPFFrontend.EnemyControl"
             mc:Ignorable="d"
             Height="Auto" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
    Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Grid.RowSpan="3" VerticalAlignment="Center" MouseUp="UserControl_MouseUp" MouseLeave="UserControl_MouseLeave">
    <UserControl.Resources>
        <wpffrontend:BitmapToImageSourceConverter x:Key="BitmapToImageSourceConverter"/>
        <wpffrontend:InkIconConverter x:Key="InkIconConverter"/>
        <wpffrontend:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <wpffrontend:PocketCountToSuffixConverter x:Key="PocketCountToSuffixConverter"/>
        <wpffrontend:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <BitmapImage x:Key="Ink1" UriSource="/artwork/character-dividers/divider_01.png"/>
        <BitmapImage x:Key="Ink2" UriSource="/artwork/character-dividers/divider_02.png"/>
        <BitmapImage x:Key="Ink3" UriSource="/artwork/character-dividers/divider_03.png"/>
        <BitmapImage x:Key="Ink4" UriSource="/artwork/character-dividers/divider_04.png"/>
        <BitmapImage x:Key="Ink5" UriSource="/artwork/character-dividers/divider_05.png"/>
        <!-- All five strokes are 1180 x 19 pixels. Draw the outer tenths at half
             size, and let the middle absorb differences in localized card widths. -->
        <DataTemplate x:Key="InkDivider">
            <Grid Height="9.5" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="59"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="59"/>
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{Binding}" Viewbox="0,0,0.1,1" Stretch="Fill"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Grid.Column="1">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{Binding}" Viewbox="0.1,0,0.8,1" Stretch="Fill"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Grid.Column="2">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{Binding}" Viewbox="0.9,0,0.1,1" Stretch="Fill"/>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
        </DataTemplate>
        <!-- Reuse the actual divider strokes for the vertical ink track and thumb. -->
        <ControlTemplate x:Key="InkScrollButton" TargetType="RepeatButton">
            <Border Background="Transparent"/>
        </ControlTemplate>
        <Style x:Key="CardScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Image Source="{StaticResource Ink2}" Stretch="Fill" Opacity="0.38" Height="4">
                                <Image.LayoutTransform><RotateTransform Angle="90"/></Image.LayoutTransform>
                            </Image>
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Template="{StaticResource InkScrollButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Image Source="{StaticResource Ink5}" Stretch="Fill" Height="12">
                                                        <Image.LayoutTransform><RotateTransform Angle="90"/></Image.LayoutTransform>
                                                    </Image>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Template="{StaticResource InkScrollButton}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="IconAndName">
            <DockPanel Margin="0,0,8,0" Background="Transparent">
                <!-- No icon in the resource -> no placeholder, just the name (Visibility Collapsed removes the slot instead of leaving blank space). -->
                <Image Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}"
                       Width="24" Height="24" Margin="0,0,3,0">
                    <Image.Source>
                        <MultiBinding Converter="{StaticResource InkIconConverter}" Mode="OneWay">
                            <Binding/>
                            <Binding Path="(bg:Configuration.BuffInkFilter)"/>
                        </MultiBinding>
                    </Image.Source>
                </Image>
                <TextBlock Text="{Binding Name}" Style="{StaticResource Protections}" Foreground="Black"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>
    <i:Interaction.Behaviors>
        <i:MouseDragElementBehavior/>
    </i:Interaction.Behaviors>
    <Viewbox StretchDirection="DownOnly">
    <Grid x:Name="CardContent" Width="{DynamicResource EnemyControlWidth}" MaxHeight="{DynamicResource CardHeightLimit}">
        <!-- The paper ends underneath the outer ink stroke of the frame. -->
        <Border Margin="3,4.5,3,2" CornerRadius="5">
            <Border.Background>
                <ImageBrush ImageSource="/pexels-photo-235985.jpeg" Stretch="UniformToFill"/>
            </Border.Background>
        </Border>
        <!-- Frame art follows the measured card. Its tall edge bitmaps must not size the card. -->
        <Canvas x:Name="FrameLayer" IsHitTestVisible="False">
        <Grid Width="{Binding ActualWidth, ElementName=FrameLayer}" Height="{Binding ActualHeight, ElementName=FrameLayer}"
              UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality">
            <Grid.Resources>
                <Style TargetType="Image">
                    <Setter Property="Stretch" Value="Fill"/>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Row="0" Grid.Column="0" Source="/artwork/character-frame/top_left.png"/>
            <Image Grid.Row="0" Grid.Column="1" Source="/artwork/character-frame/top.png"/>
            <Image Grid.Row="0" Grid.Column="2" Source="/artwork/character-frame/top_right.png"/>
            <Image Grid.Row="1" Grid.Column="0" Source="/artwork/character-frame/left.png"/>
            <Image Grid.Row="1" Grid.Column="2" Source="/artwork/character-frame/right.png"/>
            <Image Grid.Row="2" Grid.Column="0" Source="/artwork/character-frame/bottom_left.png"/>
            <Image Grid.Row="2" Grid.Column="1" Source="/artwork/character-frame/bottom.png"/>
            <Image Grid.Row="2" Grid.Column="2" Source="/artwork/character-frame/bottom_right.png"/>
        </Grid>
        </Canvas>
        <DockPanel Margin="10">
            <Grid DockPanel.Dock="Top">
                <Label x:Name="Level" d:Content="41" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <StackPanel Margin="56,2">
                    <Label x:Name="EnemyName" Style="{StaticResource Bold}" d:Content="Дуэргар" HorizontalAlignment="Center" ClipToBounds="True" Content="{Binding Name2}"/>
                    <Label x:Name="ClassesAndLevels" d:Content="Fighter/Mage/Thief" HorizontalContentAlignment="Center">
                        <Label.ContentTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
                            </DataTemplate>
                        </Label.ContentTemplate>
                    </Label>
                    <Label x:Name="Race" d:Content="78m" HorizontalAlignment="Center" ClipToBounds="True"/>
                </StackPanel>
                <Label x:Name="CloseTarget" Content="×" FontFamily="Segoe UI" FontSize="28" FontWeight="Bold"
                       Width="44" Height="44" Padding="0" Background="Transparent" Cursor="Hand"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MouseDown="Label_MouseDown"/>
            </Grid>
            <ScrollViewer x:Name="CardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" CanContentScroll="False">
                <ScrollViewer.Template>
                    <ControlTemplate TargetType="ScrollViewer">
                        <DockPanel>
                            <ScrollBar x:Name="PART_VerticalScrollBar" DockPanel.Dock="Right" Style="{StaticResource CardScrollBar}"
                                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}"/>
                        </DockPanel>
                    </ControlTemplate>
                </ScrollViewer.Template>
            <StackPanel>
            <ContentPresenter Content="{StaticResource Ink1}" ContentTemplate="{StaticResource InkDivider}"
                              Visibility="{Binding Visibility, ElementName=BuffStack}"/>
            <wpffrontend:CenteredWrapPanel x:Name="BuffStack" Margin="5,0" Visibility="Collapsed">
                <wpffrontend:CenteredWrapPanel.Resources>
                    <Style TargetType="{x:Type wpffrontend:BuffControl}">
                        <Setter Property="Margin" Value="1"/>
                        <Setter Property="Width" Value="{Binding MaxWidth, RelativeSource={RelativeSource Self}}"/>
                        <Setter Property="Height" Value="{Binding MaxHeight, RelativeSource={RelativeSource Self}}"/>
                    </Style>
                </wpffrontend:CenteredWrapPanel.Resources>
            </wpffrontend:CenteredWrapPanel>
            <ContentPresenter Content="{StaticResource Ink2}" ContentTemplate="{StaticResource InkDivider}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1">
                <!-- Only the base STR score animates - the "/exceptional" percentile (18/xx) is
                     baked into the Format string as a literal suffix, like Health's max HP. -->
                <wpffrontend:RollingLabel Style="{StaticResource RollingLabelAttributes}" x:Name="STR" HorizontalAlignment="Center" d:Text="STR: 18/76"/>
                <wpffrontend:RollingLabel Style="{StaticResource RollingLabelAttributes}" x:Name="DEX" HorizontalAlignment="Center" ClipToBounds="True" d:Text="DEX: 16"/>
                <wpffrontend:RollingLabel Style="{StaticResource RollingLabelAttributes}" x:Name="CON" HorizontalAlignment="Center" ClipToBounds="True" d:Text="CON: 17"/>
                <wpffrontend:RollingLabel Style="{StaticResource RollingLabelAttributes}" x:Name="INT" HorizontalAlignment="Center" ClipToBounds="True" d:Text="INT: 10"/>
                <wpffrontend:RollingLabel Style="{StaticResource RollingLabelAttributes}" x:Name="WIS" HorizontalAlignment="Center" ClipToBounds="True" d:Text="WIS: 12"/>
                <wpffrontend:RollingLabel Style="{StaticResource RollingLabelAttributes}" x:Name="CHA" HorizontalAlignment="Center" ClipToBounds="True" d:Text="CHR: 14"/>
            </StackPanel>
            <ContentPresenter Content="{StaticResource Ink3}" ContentTemplate="{StaticResource InkDivider}"/>
            <Grid Margin="1,0" UseLayoutRounding="True">
                <Grid.Resources>
                    <Style TargetType="Image">
                        <Setter Property="MaxWidth" Value="40"/>
                        <Setter Property="Height" Value="22"/>
                        <Setter Property="Stretch" Value="Uniform"/>
                        <Setter Property="Margin" Value="3,2,4,3"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
                    </Style>
                    <Style TargetType="wpffrontend:RollingLabel" BasedOn="{StaticResource RollingLabelDefault}">
                        <Setter Property="Margin" Value="-16,2,4,3"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14*"/>
                    <ColumnDefinition Width="36*"/>
                    <ColumnDefinition Width="14*"/>
                    <ColumnDefinition Width="36*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Image Grid.Row="0" Grid.Column="0" Source="/icons/character/health.png"/>
                <wpffrontend:RollingLabel x:Name="Health" Grid.Row="0" Grid.Column="1" d:Text="Health: 87/95"/>
                <Image Grid.Row="0" Grid.Column="2" Source="/icons/character/resist_fire.png"/>
                <wpffrontend:RollingLabel x:Name="ResFire" Grid.Row="0" Grid.Column="3" d:Text="Resist Fire: 10"/>

                <Image Grid.Row="1" Grid.Column="0" Source="/icons/character/attacks.png"/>
                <wpffrontend:RollingLabel x:Name="APR" Grid.Row="1" Grid.Column="1" d:Text="Attacks: 3/2"/>
                <Image Grid.Row="1" Grid.Column="2" Source="/icons/character/resist_cold.png"/>
                <wpffrontend:RollingLabel x:Name="ResCold" Grid.Row="1" Grid.Column="3" d:Text="Resist Cold: 10"/>

                <Image Grid.Row="2" Grid.Column="0" Source="/icons/character/armor_class.png"/>
                <wpffrontend:RollingLabel x:Name="AC" Grid.Row="2" Grid.Column="1" d:Text="Armor Class: -2"/>
                <Image Grid.Row="2" Grid.Column="2" Source="/icons/character/resist_electricity.png"/>
                <wpffrontend:RollingLabel x:Name="ResElectro" Grid.Row="2" Grid.Column="3" d:Text="Resist Electricity: 0"/>

                <Image Grid.Row="3" Grid.Column="0" Source="/icons/character/thac0.png"/>
                <wpffrontend:RollingLabel x:Name="THAC0" Grid.Row="3" Grid.Column="1" d:Text="THAC0: 11"/>
                <Image Grid.Row="3" Grid.Column="2" Source="/icons/character/resist_acid.png"/>
                <wpffrontend:RollingLabel x:Name="ResAcid" Grid.Row="3" Grid.Column="3" d:Text="Resist Acid: 0"/>

                <Image Grid.Row="4" Grid.Column="0" Source="/icons/character/experience.png"/>
                <wpffrontend:RollingLabel x:Name="XP" Grid.Row="4" Grid.Column="1" d:Text="Experience: 12000"/>
                <Image Grid.Row="4" Grid.Column="2" Source="/icons/character/resist_magic.png"/>
                <wpffrontend:RollingLabel x:Name="ResMagic" Grid.Row="4" Grid.Column="3" d:Text="Resist Magic: 10"/>

                <Image Grid.Row="5" Grid.Column="0" Source="/icons/character/alignment.png"/>
                <wpffrontend:RollingLabel x:Name="Alignment" Grid.Row="5" Grid.Column="1" d:Text="Alignment: Chaotic evil"/>
                <Image Grid.Row="5" Grid.Column="2" Source="/icons/character/resist_magic_damage.png"/>
                <wpffrontend:RollingLabel x:Name="ResMagicDamage" Grid.Row="5" Grid.Column="3" d:Text="Resist Magic Dmg: 0"/>

                <Image Grid.Row="6" Grid.Column="0" Source="/icons/character/save_vs_death.png"/>
                <wpffrontend:RollingLabel x:Name="SaveDeath" Grid.Row="6" Grid.Column="1" d:Text="Save vs Death: 6"/>
                <Image Grid.Row="6" Grid.Column="2" Source="/icons/character/resist_poison.png"/>
                <wpffrontend:RollingLabel x:Name="ResPoison" Grid.Row="6" Grid.Column="3" d:Text="Resist Poison: 0"/>

                <Image Grid.Row="7" Grid.Column="0" Source="/icons/character/save_vs_wands.png"/>
                <wpffrontend:RollingLabel x:Name="SaveWands" Grid.Row="7" Grid.Column="1" d:Text="Save vs Wands: 7"/>
                <Image Grid.Row="7" Grid.Column="2" Source="/icons/character/resist_slashing.png"/>
                <wpffrontend:RollingLabel x:Name="ResSlashing" Grid.Row="7" Grid.Column="3" d:Text="Resist Slashing: 0"/>

                <Image Grid.Row="8" Grid.Column="0" Source="/icons/character/save_vs_polymorph.png"/>
                <wpffrontend:RollingLabel x:Name="SavePolymorph" Grid.Row="8" Grid.Column="1" d:Text="Save vs Polymorph: 8"/>
                <Image Grid.Row="8" Grid.Column="2" Source="/icons/character/resist_crushing.png"/>
                <wpffrontend:RollingLabel x:Name="ResCrushing" Grid.Row="8" Grid.Column="3" d:Text="Resist Crushing: 0"/>

                <Image Grid.Row="9" Grid.Column="0" Source="/icons/character/save_vs_breath.png"/>
                <wpffrontend:RollingLabel x:Name="SaveBreath" Grid.Row="9" Grid.Column="1" d:Text="Save vs Breath: 9"/>
                <Image Grid.Row="9" Grid.Column="2" Source="/icons/character/resist_piercing.png"/>
                <wpffrontend:RollingLabel x:Name="ResPiercing" Grid.Row="9" Grid.Column="3" d:Text="Resist Piercing: 0"/>

                <Image Grid.Row="10" Grid.Column="0" Source="/icons/character/save_vs_spells.png"/>
                <wpffrontend:RollingLabel x:Name="SaveSpells" Grid.Row="10" Grid.Column="1" d:Text="Save vs Spells: 8"/>
                <Image Grid.Row="10" Grid.Column="2" Source="/icons/character/resist_missile.png"/>
                <wpffrontend:RollingLabel x:Name="ResMissile" Grid.Row="10" Grid.Column="3" d:Text="Resist Missile: 0"/>
            </Grid>
            <ContentPresenter Content="{StaticResource Ink4}" ContentTemplate="{StaticResource InkDivider}"
                              Visibility="{Binding Visibility, ElementName=protectionsPanel}"/>
            <StackPanel x:Name="protectionsPanel" Margin="5,0" Visibility="Collapsed">
                <StackPanel x:Name="featPanel" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Str_Feats}" FontFamily="{DynamicResource FontFamily1}" FontSize="13"
                               FontWeight="Bold" Foreground="Black" TextAlignment="Center"/>
                    <ItemsControl x:Name="featRows" Margin="0,2,0,0">
                        <ItemsControl.Resources>
                            <Style TargetType="ToolTip">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value><DataTemplate><TextBlock Text="{Binding}" MaxWidth="360" TextWrapping="Wrap"/></DataTemplate></Setter.Value>
                                </Setter>
                            </Style>
                        </ItemsControl.Resources>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource IconAndName}" Margin="0,0,0,1">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="ToolTip" Value="{Binding Description}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <ListView BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="False"
                          HorizontalContentAlignment="Stretch" ItemsSource="{Binding Protections}" Background="{x:Null}" Foreground="{x:Null}">
                    <ListView.Resources>
                        <!-- Most Protections entries are plain strings, rendered exactly as before.
                             Implicit (DataType-keyed, no x:Key) templates here let this single
                             ListView render both plain-string lines and the icon-carrying
                             SpellImmunityLine entry below without a template selector. -->
                        <DataTemplate DataType="{x:Type sys:String}">
                            <TextBlock Text="{Binding}" Style="{StaticResource Protections}" Foreground="Black" TextWrapping="Wrap"/>
                        </DataTemplate>

                        <!-- The "Immune to spells" entry carries each spell's icon (when the resource
                             has one) alongside its name instead of one long comma-joined string. -->
                        <DataTemplate DataType="{x:Type bg:SpellImmunityLine}">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                                <!-- HorizontalAlignment="Stretch" + TextAlignment="Center" (rather than
                                     HorizontalAlignment="Center", which shrinks the TextBlock to its own
                                     text and can look off-center against the ItemsControl below it) so
                                     the header spans the exact same width as the UniformGrid underneath
                                     and centers within that, not within its own tight bounding box. -->
                                <TextBlock Text="{Binding Label}" FontFamily="{DynamicResource FontFamily1}" FontSize="13" FontWeight="Bold" Foreground="Black"
                                           TextWrapping="Wrap" HorizontalAlignment="Stretch" TextAlignment="Center"/>
                                <!-- Shared by spell immunities, feats and proficiencies. -->
                                <ItemsControl ItemTemplate="{StaticResource IconAndName}" ItemsSource="{Binding Spells}" Margin="0,2,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,0,2"/></Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type bg:EffectImmunityLine}">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontFamily="{DynamicResource FontFamily1}" FontSize="13" FontWeight="Bold" Foreground="Black"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" Columns="3"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Protections}" Foreground="Black"
                                                                   TextWrapping="Wrap" Margin="0,0,6,0"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.Resources>
                </ListView>
            </StackPanel>
            <ContentPresenter Content="{StaticResource Ink5}" ContentTemplate="{StaticResource InkDivider}"
                              Visibility="{Binding Visibility, ElementName=WeaponPanel}"/>
            <Border x:Name="WeaponPanel" Padding="6" Visibility="Collapsed"
                    TextElement.FontFamily="{DynamicResource FontFamily2}" TextElement.FontSize="{DynamicResource FontSize2}" TextElement.FontWeight="Bold">
                <Border.Resources>
                    <BooleanToVisibilityConverter x:Key="DamageIconVisibility"/>
                    <BitmapImage x:Key="AttackIcon" UriSource="/icons/character/attacks.png"/>
                    <Style x:Key="WeaponRowIcon" TargetType="Image">
                        <Setter Property="Width" Value="32"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
                    </Style>
                    <DataTemplate x:Key="WeaponDamageTemplate">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel.Resources>
                                <Style TargetType="Image" BasedOn="{StaticResource WeaponRowIcon}">
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                </Style>
                            </StackPanel.Resources>
                            <Image Source="/icons/damage/slashing.png" Visibility="{Binding Slashing, Converter={StaticResource DamageIconVisibility}}"/>
                            <Image Source="/icons/damage/piercing.png" Visibility="{Binding Piercing, Converter={StaticResource DamageIconVisibility}}"/>
                            <Image Source="/icons/damage/blunt.png" Visibility="{Binding Blunt, Converter={StaticResource DamageIconVisibility}}"/>
                            <Image Source="/icons/damage/missile.png" Visibility="{Binding Missile, Converter={StaticResource DamageIconVisibility}}"/>
                            <TextBlock Text="{Binding Range}" AutomationProperties.Name="{Binding AccessibleName}" VerticalAlignment="Center" d:Text="6–9"/>
                        </StackPanel>
                    </DataTemplate>
                </Border.Resources>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image x:Name="WeaponIcon" Style="{StaticResource WeaponRowIcon}"
                           Source="{Binding Converter={StaticResource BitmapToImageSourceConverter}, TargetNullValue={StaticResource AttackIcon}}"/>
                    <TextBlock x:Name="WeaponDescription" Grid.Column="1" Margin="4,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <ContentPresenter x:Name="Damage" Grid.Column="2" ContentTemplate="{StaticResource WeaponDamageTemplate}"/>
                    <Image x:Name="SecondaryWeaponIcon" Grid.Row="1" Style="{StaticResource WeaponRowIcon}"
                           Source="{Binding Converter={StaticResource BitmapToImageSourceConverter}, TargetNullValue={StaticResource AttackIcon}}"
                           Visibility="{Binding Visibility, ElementName=SecondaryWeaponDescription}"/>
                    <TextBlock x:Name="SecondaryWeaponDescription" Grid.Row="1" Grid.Column="1" Margin="4,0" VerticalAlignment="Center"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <ContentPresenter x:Name="SecondaryWeaponDamage" Grid.Row="1" Grid.Column="2" Visibility="Collapsed"
                                      ContentTemplate="{StaticResource WeaponDamageTemplate}"/>
                    <StackPanel x:Name="HitSection" Grid.Row="2" Grid.ColumnSpan="3" Margin="4,2,4,0" Visibility="Collapsed">
                        <TextBlock x:Name="HitHeading" Foreground="Black" FontWeight="Bold" FontSize="{Binding FontSize, ElementName=WeaponEffects}"/>
                        <TextBlock x:Name="WeaponEffects" TextWrapping="Wrap" FontWeight="Bold" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Items this creature is carrying that can be stolen via pickpocket
                 (BGEntity.Pockets already excludes ones with the Unstealable flag set). -->
            <ContentPresenter Content="{StaticResource Ink2}" ContentTemplate="{StaticResource InkDivider}"
                              Visibility="{Binding Visibility, ElementName=pocketsSection}"/>
            <Border x:Name="pocketsSection" Padding="4,1" Visibility="Collapsed">
                <StackPanel>
                    <Label x:Name="PocketsHeader" d:Content="Pockets" HorizontalAlignment="Left" Padding="0"/>
                    <ListView x:Name="pocketsListView" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="False" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Pockets}" Background="{x:Null}" Foreground="{x:Null}">
                        <!-- 2 columns to save vertical space - each item's own Grid (icon/name/flags)
                             still adapts to whatever width that gives it. -->
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type bg:PocketItemEntry}">
                                <!-- Stacked (icon+name on top, flags below) rather than a single wide row -
                                     each item only gets half the control's width in the 2-column layout
                                     above, and a same-row right-aligned FlagsText would easily overflow
                                     that narrower slot. -->
                                <StackPanel Orientation="Vertical" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <!-- No icon in the resource -> no placeholder, just the name. -->
                                        <Image Source="{Binding Icon, Converter={StaticResource BitmapToImageSourceConverter}}"
                                               Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}"
                                               Width="24" Height="24" Margin="0,0,3,0"/>
                                        <!-- FontFamily2/FontSize2 instead of Protections' own
                                             FontFamily1/FontSize1. -->
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Protections}" FontFamily="{DynamicResource FontFamily2}" FontSize="{DynamicResource FontSize2}" Foreground="Black" TextWrapping="Wrap"/>
                                        <!-- "x{Count}" for 2+ of the same item, nothing for a single one. -->
                                        <TextBlock Text="{Binding Count, Converter={StaticResource PocketCountToSuffixConverter}}" Style="{StaticResource Protections}" FontFamily="{DynamicResource FontFamily2}" FontSize="{DynamicResource FontSize2}" Foreground="Black"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FlagsText}" Style="{StaticResource Protections}" FontFamily="{DynamicResource FontFamily2}" FontSize="{DynamicResource FontSize2}" Foreground="Black" TextWrapping="Wrap" Margin="27,0,0,0"
                                               Visibility="{Binding FlagsText, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
    </Viewbox>
</UserControl>
