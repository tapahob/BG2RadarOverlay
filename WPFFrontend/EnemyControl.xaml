<UserControl x:Name="UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
             xmlns:wpffrontend="clr-namespace:WPFFrontend"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:bg="clr-namespace:BGOverlay;assembly=BGOverlayAPI"
    x:Class="WPFFrontend.EnemyControl"
             mc:Ignorable="d" 
             Height="Auto" Width="{DynamicResource EnemyControlWidth}"
    Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Grid.RowSpan="3" VerticalAlignment="Center" MouseUp="UserControl_MouseUp" MouseLeave="UserControl_MouseLeave">
    <UserControl.BorderBrush>
        <ImageBrush/>
    </UserControl.BorderBrush>
    <UserControl.Background>
        <ImageBrush ImageSource="/pexels-photo-235985.jpeg" Stretch="UniformToFill"/>
    </UserControl.Background>
    <i:Interaction.Behaviors>
        <i:MouseDragElementBehavior/>
    </i:Interaction.Behaviors>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Border Grid.RowSpan="8" Grid.ColumnSpan="4" BorderThickness="5" BorderBrush="#FF151313"/>
        <Label x:Name="Level" Grid.Row="1" Grid.Column="1" d:Content="41" />
        <Label Grid.Row="1" Grid.Column="2" Content="X" d:Content="X" HorizontalAlignment="Right" MouseDown="Label_MouseDown" Margin="0,0,3,0"/>
        <Border Grid.ColumnSpan="2" Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="1">
            <StackPanel Margin="5,5,5,5">
                <Label x:Name="EnemyName" Style="{StaticResource Bold}" d:Content="Дуэргар" HorizontalAlignment="Center" ClipToBounds="True" Content="{Binding Name2}"/>
                <Label x:Name="ClassesAndLevels" Content="{Binding Class}" d:Content="Warrior Thief Mage" HorizontalAlignment="Center" ClipToBounds="True">
                </Label>
                <Label x:Name="Race" d:Content="78m" HorizontalAlignment="Center" ClipToBounds="True"/>
                <UniformGrid x:Name="BuffStack" Columns="8"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="4" BorderBrush="Black" BorderThickness="0" Margin="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Label Style="{StaticResource Attributes}" x:Name="STR" d:Content="18/00" HorizontalAlignment="Center"/>
                <Label Style="{StaticResource Attributes}" x:Name="DEX" d:Content="25" HorizontalAlignment="Center" ClipToBounds="True"/>
                <Label Style="{StaticResource Attributes}" x:Name="CON" d:Content="25" HorizontalAlignment="Center" ClipToBounds="True"/>
                <Label Style="{StaticResource Attributes}" x:Name="INT" d:Content="25" HorizontalAlignment="Center" ClipToBounds="True"/>
                <Label Style="{StaticResource Attributes}" x:Name="WIS" d:Content="25" HorizontalAlignment="Center" ClipToBounds="True"/>
                <Label Style="{StaticResource Attributes}" x:Name="CHA" d:Content="25" HorizontalAlignment="Center" ClipToBounds="True"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="Black" BorderThickness="1" Margin="1"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Margin="5,5,5,5">
            <Label x:Name="Health" d:Content="25" HorizontalAlignment="Left" ClipToBounds="True"/>
            <Label x:Name="APR" d:Content="3" HorizontalAlignment="Left" ClipToBounds="True"/>
            <Label x:Name="AC" d:Content="25" HorizontalAlignment="Left" ClipToBounds="True"/>
            <Label x:Name="THAC0" d:Content="25" HorizontalAlignment="Left" ClipToBounds="True"/>
            <Label x:Name="XP" d:Content="25" HorizontalAlignment="Left" ClipToBounds="True" Panel.ZIndex="1"/>
            <Label x:Name="Alignment" d:Content="25" HorizontalAlignment="Left" ClipToBounds="True"/>
            <Label x:Name="SaveDeath" d:Content="25" HorizontalAlignment="Left" ClipToBounds="True"/>
            <Label x:Name="SaveWands" d:Content="25" HorizontalAlignment="Left" ClipToBounds="True"/>
            <Label x:Name="SavePolymorph" d:Content="25" HorizontalAlignment="Left" ClipToBounds="True"/>
            <Label x:Name="SaveBreath" d:Content="25" HorizontalAlignment="Left" ClipToBounds="True"/>
            <Label x:Name="SaveSpells" d:Content="25" HorizontalAlignment="Left" ClipToBounds="True"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="2" Margin="5,5,5,5">
            <Label x:Name="ResFire" d:Content="25" HorizontalAlignment="Left"  ClipToBounds="True"/>
            <Label x:Name="ResCold" d:Content="25" HorizontalAlignment="Left"  ClipToBounds="True"/>
            <Label x:Name="ResElectro" d:Content="25" HorizontalAlignment="Left"  ClipToBounds="True"/>
            <Label x:Name="ResAcid" d:Content="25" HorizontalAlignment="Left"  ClipToBounds="True"/>
            <Label x:Name="ResMagic" d:Content="25" HorizontalAlignment="Left"  ClipToBounds="True"/>
            <Label x:Name="ResMagicDamage" d:Content="25" HorizontalAlignment="Left"  ClipToBounds="True"/>
            <Label x:Name="ResPoison" d:Content="25" HorizontalAlignment="Left"  ClipToBounds="True"/>
            <Label x:Name="ResSlashing" d:Content="25" HorizontalAlignment="Left"  ClipToBounds="True"/>
            <Label x:Name="ResCrushing" d:Content="25" HorizontalAlignment="Left"  ClipToBounds="True"/>
            <Label x:Name="ResPiercing" d:Content="25" HorizontalAlignment="Left"  ClipToBounds="True"/>
            <Label x:Name="ResMissile" d:Content="25" HorizontalAlignment="Left"  ClipToBounds="True"/>
        </StackPanel>
        <ListView x:Name="protectionsListView" BorderThickness="1" BorderBrush="Black" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="False"  Grid.Row="5" ItemsSource="{Binding Protections}" Grid.Column="1" Grid.ColumnSpan="2" Margin="1,5,1,1" Background="{x:Null}" Foreground="{x:Null}" Visibility="Collapsed">
            <ListView.Resources>
                <wpffrontend:BitmapToImageSourceConverter x:Key="BitmapToImageSourceConverter"/>
                <wpffrontend:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
                <wpffrontend:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

                <!-- Most Protections entries are plain strings, rendered exactly as before.
                     Implicit (DataType-keyed, no x:Key) templates here let this single
                     ListView render both plain-string lines and the icon-carrying
                     SpellImmunityLine entry below without a template selector. -->
                <DataTemplate DataType="{x:Type sys:String}">
                    <TextBlock Text="{Binding}" Style="{StaticResource Protections}" Foreground="Black" TextWrapping="Wrap"/>
                </DataTemplate>

                <!-- The "Immune to spells" entry carries each spell's icon (when the resource
                     has one) alongside its name instead of one long comma-joined string. -->
                <DataTemplate DataType="{x:Type bg:SpellImmunityLine}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Protections}" Foreground="Black" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding Spells}" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type bg:SpellIconEntry}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,2">
                                        <!-- No icon in the resource -> no placeholder, just the name (Visibility Collapsed removes the slot instead of leaving blank space). -->
                                        <Image Source="{Binding Icon, Converter={StaticResource BitmapToImageSourceConverter}}"
                                               Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}"
                                               Width="24" Height="24" Margin="0,0,3,0"/>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Protections}" Foreground="Black"/>
                                        <!-- Trailing comma between spells, omitted after the last one (IsLast is set once the final sorted order is known). -->
                                        <TextBlock Text="," Style="{StaticResource Protections}" Foreground="Black"
                                                   Visibility="{Binding IsLast, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ListView.Resources>
        </ListView>
        <ListView x:Name="itemEffectsListView" BorderThickness="1" BorderBrush="Black" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="False"  Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="1,5,1,1" Background="{x:Null}" Foreground="{x:Null}" Visibility="Collapsed">
        </ListView>
    </Grid>
</UserControl>
