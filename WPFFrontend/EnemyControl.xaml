<UserControl x:Name="UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
             xmlns:wpffrontend="clr-namespace:WPFFrontend"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:bg="clr-namespace:BGOverlay;assembly=BGOverlayAPI"
    x:Class="WPFFrontend.EnemyControl"
             mc:Ignorable="d"
             Height="Auto" Width="{DynamicResource EnemyControlWidth}"
    Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Grid.RowSpan="3" VerticalAlignment="Center" MouseUp="UserControl_MouseUp" MouseLeave="UserControl_MouseLeave">
    <UserControl.Resources>
        <wpffrontend:BitmapToImageSourceConverter x:Key="BitmapToImageSourceConverter"/>
        <wpffrontend:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <wpffrontend:PocketCountToSuffixConverter x:Key="PocketCountToSuffixConverter"/>
        <wpffrontend:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
    </UserControl.Resources>
    <UserControl.BorderBrush>
        <ImageBrush/>
    </UserControl.BorderBrush>
    <UserControl.Background>
        <ImageBrush ImageSource="/pexels-photo-235985.jpeg" Stretch="UniformToFill"/>
    </UserControl.Background>
    <i:Interaction.Behaviors>
        <i:MouseDragElementBehavior/>
    </i:Interaction.Behaviors>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Border Grid.RowSpan="9" Grid.ColumnSpan="4" BorderThickness="5" BorderBrush="#FF151313"/>
        <Label x:Name="Level" Grid.Row="1" Grid.Column="1" d:Content="41" />
        <Label Grid.Row="1" Grid.Column="2" Content="X" d:Content="X" HorizontalAlignment="Right" MouseDown="Label_MouseDown" Margin="0,0,3,0"/>
        <Border Grid.ColumnSpan="2" Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="1">
            <StackPanel Margin="5,5,5,5">
                <Label x:Name="EnemyName" Style="{StaticResource Bold}" d:Content="Дуэргар" HorizontalAlignment="Center" ClipToBounds="True" Content="{Binding Name2}"/>
                <Label x:Name="ClassesAndLevels" Content="{Binding Class}" d:Content="Warrior Thief Mage" HorizontalAlignment="Center" ClipToBounds="True">
                </Label>
                <Label x:Name="Race" d:Content="78m" HorizontalAlignment="Center" ClipToBounds="True"/>
                <UniformGrid x:Name="BuffStack" Columns="8"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="4" BorderBrush="Black" BorderThickness="0" Margin="1">
            <!-- VerticalAlignment="Center" so this row's fixed 30px height doesn't leave a
                 bigger gap below the text than above it (the default Top alignment would let
                 any extra row height pile up entirely under the text instead of split evenly). -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Only the base STR score animates - the "/exceptional" percentile (18/xx) is
                     baked into the Format string as a literal suffix, like Health's max HP. -->
                <wpffrontend:RollingLabel Style="{StaticResource RollingLabelAttributes}" x:Name="STR" HorizontalAlignment="Center"/>
                <wpffrontend:RollingLabel Style="{StaticResource RollingLabelAttributes}" x:Name="DEX" HorizontalAlignment="Center" ClipToBounds="True"/>
                <wpffrontend:RollingLabel Style="{StaticResource RollingLabelAttributes}" x:Name="CON" HorizontalAlignment="Center" ClipToBounds="True"/>
                <wpffrontend:RollingLabel Style="{StaticResource RollingLabelAttributes}" x:Name="INT" HorizontalAlignment="Center" ClipToBounds="True"/>
                <wpffrontend:RollingLabel Style="{StaticResource RollingLabelAttributes}" x:Name="WIS" HorizontalAlignment="Center" ClipToBounds="True"/>
                <wpffrontend:RollingLabel Style="{StaticResource RollingLabelAttributes}" x:Name="CHA" HorizontalAlignment="Center" ClipToBounds="True"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="Black" BorderThickness="1" Margin="1"/>
        <!-- Margin="4,0,0,4" on every row below (left/bottom, no top/right) by analogy with the
             per-spell Margin="0,0,8,2" in the "Immune to spells" section - offset lives on each
             row itself rather than on the StackPanel as a whole. -->
        <StackPanel Grid.Row="3" Grid.Column="1" Margin="1,5,1,1">
            <wpffrontend:RollingLabel x:Name="Health" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
            <!-- No number to roll (Attacks can be fractional, e.g. "3/2") - RollingLabel.Format
                 is just the fully-resolved text with no "{0}" in it, which string.Format leaves
                 untouched, so this is only here for consistent styling/spacing with its
                 neighbors, not for the animation itself. -->
            <wpffrontend:RollingLabel x:Name="APR" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
            <wpffrontend:RollingLabel x:Name="AC" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
            <wpffrontend:RollingLabel x:Name="THAC0" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
            <wpffrontend:RollingLabel x:Name="XP" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True" Panel.ZIndex="1"/>
            <!-- Same reasoning as APR above - Alignment is a string (e.g. "Lawful good"), not a
                 number, so this is purely for consistent styling with its RollingLabel neighbors. -->
            <wpffrontend:RollingLabel x:Name="Alignment" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
            <wpffrontend:RollingLabel x:Name="SaveDeath" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
            <wpffrontend:RollingLabel x:Name="SaveWands" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
            <wpffrontend:RollingLabel x:Name="SavePolymorph" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
            <wpffrontend:RollingLabel x:Name="SaveBreath" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
            <wpffrontend:RollingLabel x:Name="SaveSpells" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="2" Margin="1,5,1,1">
            <wpffrontend:RollingLabel x:Name="ResFire" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
            <wpffrontend:RollingLabel x:Name="ResCold" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
            <wpffrontend:RollingLabel x:Name="ResElectro" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
            <wpffrontend:RollingLabel x:Name="ResAcid" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
            <wpffrontend:RollingLabel x:Name="ResMagic" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
            <wpffrontend:RollingLabel x:Name="ResMagicDamage" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
            <wpffrontend:RollingLabel x:Name="ResPoison" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
            <wpffrontend:RollingLabel x:Name="ResSlashing" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
            <wpffrontend:RollingLabel x:Name="ResCrushing" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
            <wpffrontend:RollingLabel x:Name="ResPiercing" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
            <wpffrontend:RollingLabel x:Name="ResMissile" Style="{StaticResource RollingLabelDefault}" Margin="6,2,0,4" HorizontalAlignment="Left" ClipToBounds="True"/>
        </StackPanel>
        <ListView x:Name="protectionsListView" BorderThickness="1" BorderBrush="Black" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="False" HorizontalContentAlignment="Stretch" Grid.Row="5" ItemsSource="{Binding Protections}" Grid.Column="1" Grid.ColumnSpan="2" Margin="1,5,1,1" Background="{x:Null}" Foreground="{x:Null}" Visibility="Collapsed">
            <ListView.Resources>
                <!-- Most Protections entries are plain strings, rendered exactly as before.
                     Implicit (DataType-keyed, no x:Key) templates here let this single
                     ListView render both plain-string lines and the icon-carrying
                     SpellImmunityLine entry below without a template selector. -->
                <DataTemplate DataType="{x:Type sys:String}">
                    <TextBlock Text="{Binding}" Style="{StaticResource Protections}" Foreground="Black" TextWrapping="Wrap"/>
                </DataTemplate>

                <!-- The "Immune to spells" entry carries each spell's icon (when the resource
                     has one) alongside its name instead of one long comma-joined string. -->
                <DataTemplate DataType="{x:Type bg:SpellImmunityLine}">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                        <!-- HorizontalAlignment="Stretch" + TextAlignment="Center" (rather than
                             HorizontalAlignment="Center", which shrinks the TextBlock to its own
                             text and can look off-center against the ItemsControl below it) so
                             the header spans the exact same width as the UniformGrid underneath
                             and centers within that, not within its own tight bounding box. -->
                        <TextBlock Text="{Binding Label}" FontFamily="{DynamicResource FontFamily1}" FontSize="13" FontWeight="Bold" Foreground="Black"
                                   TextWrapping="Wrap" HorizontalAlignment="Stretch" TextAlignment="Center"/>
                        <!-- 2 columns to save space, by analogy with the Pockets section - no
                             trailing commas needed once spells aren't run together in a wrapped
                             single-line list. -->
                        <ItemsControl ItemsSource="{Binding Spells}" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type bg:SpellIconEntry}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,2">
                                        <!-- No icon in the resource -> no placeholder, just the name (Visibility Collapsed removes the slot instead of leaving blank space). -->
                                        <Image Source="{Binding Icon, Converter={StaticResource BitmapToImageSourceConverter}}"
                                               Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}"
                                               Width="24" Height="24" Margin="0,0,3,0"/>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Protections}" Foreground="Black" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ListView.Resources>
        </ListView>
        <ListView x:Name="itemEffectsListView" BorderThickness="1" BorderBrush="Black" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="False"  Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="1,5,1,1" Background="{x:Null}" Foreground="{x:Null}" Visibility="Collapsed">
        </ListView>

        <!-- Items this creature is carrying that can be stolen via pickpocket
             (BGEntity.Pockets already excludes ones with the Unstealable flag set). -->
        <StackPanel x:Name="pocketsSection" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="1,5,1,1" Visibility="Collapsed">
            <Label x:Name="PocketsHeader" d:Content="Pockets" HorizontalAlignment="Left" Padding="0"/>
            <ListView x:Name="pocketsListView" BorderThickness="1" BorderBrush="Black" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="False" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Pockets}" Background="{x:Null}" Foreground="{x:Null}">
                <!-- 2 columns to save vertical space - each item's own Grid (icon/name/flags)
                     still adapts to whatever width that gives it. -->
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type bg:PocketItemEntry}">
                        <!-- Stacked (icon+name on top, flags below) rather than a single wide row -
                             each item only gets half the control's width in the 2-column layout
                             above, and a same-row right-aligned FlagsText would easily overflow
                             that narrower slot. -->
                        <StackPanel Orientation="Vertical" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <!-- No icon in the resource -> no placeholder, just the name. -->
                                <Image Source="{Binding Icon, Converter={StaticResource BitmapToImageSourceConverter}}"
                                       Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}"
                                       Width="24" Height="24" Margin="0,0,3,0"/>
                                <!-- FontFamily2/FontSize2 instead of Protections' own
                                     FontFamily1/FontSize1. -->
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Protections}" FontFamily="{DynamicResource FontFamily2}" FontSize="{DynamicResource FontSize2}" Foreground="Black" TextWrapping="Wrap"/>
                                <!-- "x{Count}" for 2+ of the same item, nothing for a single one. -->
                                <TextBlock Text="{Binding Count, Converter={StaticResource PocketCountToSuffixConverter}}" Style="{StaticResource Protections}" FontFamily="{DynamicResource FontFamily2}" FontSize="{DynamicResource FontSize2}" Foreground="Black"/>
                            </StackPanel>
                            <TextBlock Text="{Binding FlagsText}" Style="{StaticResource Protections}" FontFamily="{DynamicResource FontFamily2}" FontSize="{DynamicResource FontSize2}" Foreground="Black" TextWrapping="Wrap" Margin="27,0,0,0"
                                       Visibility="{Binding FlagsText, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</UserControl>
