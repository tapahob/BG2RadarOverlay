<Application x:Class="WPFFrontend.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WPFFrontend" xmlns:system="clr-namespace:System;assembly=System.Runtime"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <!-- Locale resources can override these fallback widths. -->
                    <system:Double x:Key="EnemyControlWidth">570</system:Double>
                    <system:Double x:Key="OptionsControlWidth">445</system:Double>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <!--BoldCyrilic-->
            <FontFamily x:Key="FontFamily1">Segoe Print</FontFamily>
            <system:Double x:Key="FontSize1">16</system:Double>
            
            <!--The rest-->
            <FontFamily x:Key="FontFamily2">Ink Free</FontFamily>
            <system:Double x:Key="FontSize2">16</system:Double>
            
            <FontFamily x:Key="FontFamilyBuff">Bahnschrift Condensed</FontFamily>
            <system:Double x:Key="FontSize3Big">16</system:Double>
            <system:Double x:Key="FontSize3Small">12</system:Double>

            <Style TargetType="{x:Type Label}">
                <Setter Property="FontSize" Value="{DynamicResource FontSize2}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily2}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <Style TargetType="{x:Type Label}" BasedOn="{StaticResource {x:Type Label}}" x:Key="Attributes">
                <Setter Property="FontSize" Value="16" />
            </Style>

            <!-- RollingLabel is a TextBlock (not a Label), so it doesn't pick up the implicit
                 Label style above automatically - these two mirror it (and Attributes) for use
                 on RollingLabel elements in EnemyControl. -->
            <Style TargetType="{x:Type local:RollingLabel}" x:Key="RollingLabelDefault">
                <Setter Property="FontSize" Value="{DynamicResource FontSize2}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily2}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <Style TargetType="{x:Type local:RollingLabel}" BasedOn="{StaticResource RollingLabelDefault}" x:Key="RollingLabelAttributes">
                <Setter Property="FontSize" Value="16" />
                <!-- RollingLabel is a bare TextBlock, which has no built-in padding the way
                     Label does - Padding (not Margin) on both sides matches Label's own default
                     padding, so every gap in the STR/DEX/CON/INT/WIS/CHA row (including the one
                     next to STR, which is still a plain Label) ends up the same width instead of
                     one side contributing padding and the other not. -->
                <Setter Property="Padding" Value="5,0,5,0" />
            </Style>

            <Style TargetType="{x:Type Label}" BasedOn="{StaticResource {x:Type Label}}" x:Key="Bold">
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily1}" />
            </Style>

            <Style TargetType="{x:Type Label}" BasedOn="{StaticResource Bold}" x:Key="BoldSmall">
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style TargetType="{x:Type Label}" BasedOn="{StaticResource Bold}" x:Key="BoldHeader">
                <Setter Property="FontSize" Value="18" />
            </Style>

            <Style TargetType="{x:Type TextBlock}" x:Key="Protections">
                <Setter Property="FontSize" Value="{DynamicResource FontSize1}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily1}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <Style TargetType="{x:Type TextBlock}" x:Key="ItemEffects">
                <Setter Property="FontSize" Value="{DynamicResource FontSize1}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily1}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <Style TargetType="{x:Type TextBlock}" x:Key="EnemyList">
                <Setter Property="FontSize" Value="{DynamicResource FontSize1}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily1}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <Style TargetType="Label" x:Key="BuffTimerBig">
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBuff}" />
                <Setter Property="FontSize" Value="{DynamicResource FontSize3Big}" />
            </Style>
            <Style TargetType="Label" BasedOn="{StaticResource BuffTimerBig}" x:Key="BuffTimerSmall">
                <Setter Property="FontSize" Value="{DynamicResource FontSize3Small}" />
            </Style>

            <Style x:Key="OptionsHover" TargetType="Border">
                <Setter Property="Background" Value="#75FFE2A4"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Opacity" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                            </Storyboard></BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                            </Storyboard></BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Visibility" Value="Hidden"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <LinearGradientBrush x:Key="TabLeather" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#573821" Offset="0"/>
                <GradientStop Color="#38251A" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SelectedTabLeather" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#865D36" Offset="0"/>
                <GradientStop Color="#573821" Offset="1"/>
            </LinearGradientBrush>

            <Style TargetType="{x:Type TabItem}">
                <Setter Property="FontFamily" Value="Segoe Print" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="#E7C990" />
                <Setter Property="Background" Value="{StaticResource TabLeather}" />
                <Setter Property="Padding" Value="9,3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Border x:Name="Frame" BorderBrush="#302015" BorderThickness="1" Margin="0,0,2,0"
                                    Background="{TemplateBinding Background}">
                                <Grid>
                                    <Border x:Name="HeaderHover" Background="#28FFE2A4" IsHitTestVisible="False" Opacity="0"/>
                                    <Border x:Name="Rim" BorderBrush="#99815C" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- TabItem.IsMouseOver also tracks its logically parented content. -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition SourceName="Frame" Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsEnabled" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <MultiTrigger.EnterActions>
                                        <BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HeaderHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard></BeginStoryboard>
                                    </MultiTrigger.EnterActions>
                                    <MultiTrigger.ExitActions>
                                        <BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HeaderHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                        </Storyboard></BeginStoryboard>
                                    </MultiTrigger.ExitActions>
                                </MultiTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SelectedTabLeather}"/>
                                    <Setter Property="Foreground" Value="#FFE8B9"/>
                                    <Setter TargetName="Rim" Property="BorderBrush" Value="#D9B36F"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Rim" Property="BorderBrush" Value="#FFE8B9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type TabControl}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent"/>
                                <Border Grid.Row="1" BorderBrush="#705037" BorderThickness="1" Background="Transparent">
                                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
