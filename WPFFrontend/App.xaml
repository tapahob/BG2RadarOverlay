<Application x:Class="WPFFrontend.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WPFFrontend" xmlns:system="clr-namespace:System;assembly=System.Runtime"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

            <!--BoldCyrilic-->
            <FontFamily x:Key="FontFamily1">Segoe Print</FontFamily>
            <system:Double x:Key="FontSize1">16</system:Double>
            
            <!--The rest-->
            <FontFamily x:Key="FontFamily2">Ink Free</FontFamily>
            <system:Double x:Key="FontSize2">16</system:Double>
            
            <FontFamily x:Key="FontFamilyBuff">Bahnschrift Condensed</FontFamily>
            <system:Double x:Key="FontSize3Big">16</system:Double>
            <system:Double x:Key="FontSize3Small">12</system:Double>

            <!-- EnemyControl's/OptionsControl's default/fallback width - some languages need
                 more room for their translated labels than English does; a locale file can
                 override either via the EnemyControlWidth/OptionsControlWidth key (see
                 MainWindow.applyLocalization). 445 is OptionsControl's previous fixed width
                 (the sum of its Grid's column widths: 10+180+15+180+10) plus the 50px widened
                 for the Locale row's restart note, now the default/fallback instead of a
                 hardcoded value on the control itself. -->
            <system:Double x:Key="EnemyControlWidth">450</system:Double>
            <system:Double x:Key="OptionsControlWidth">445</system:Double>

            <Style TargetType="{x:Type Label}">
                <Setter Property="FontSize" Value="{DynamicResource FontSize2}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily2}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <Style TargetType="{x:Type Label}" BasedOn="{StaticResource {x:Type Label}}" x:Key="Attributes">
                <Setter Property="FontSize" Value="16" />
            </Style>

            <!-- RollingLabel is a TextBlock (not a Label), so it doesn't pick up the implicit
                 Label style above automatically - these two mirror it (and Attributes) for use
                 on RollingLabel elements in EnemyControl. -->
            <Style TargetType="{x:Type local:RollingLabel}" x:Key="RollingLabelDefault">
                <Setter Property="FontSize" Value="{DynamicResource FontSize2}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily2}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <Style TargetType="{x:Type local:RollingLabel}" BasedOn="{StaticResource RollingLabelDefault}" x:Key="RollingLabelAttributes">
                <Setter Property="FontSize" Value="16" />
                <!-- RollingLabel is a bare TextBlock, which has no built-in padding the way
                     Label does - Padding (not Margin) on both sides matches Label's own default
                     padding, so every gap in the STR/DEX/CON/INT/WIS/CHA row (including the one
                     next to STR, which is still a plain Label) ends up the same width instead of
                     one side contributing padding and the other not. -->
                <Setter Property="Padding" Value="5,0,5,0" />
            </Style>

            <Style TargetType="{x:Type Label}" BasedOn="{StaticResource {x:Type Label}}" x:Key="Bold">
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily1}" />
            </Style>

            <Style TargetType="{x:Type Label}" BasedOn="{StaticResource Bold}" x:Key="BoldSmall">
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style TargetType="{x:Type Label}" BasedOn="{StaticResource Bold}" x:Key="BoldHeader">
                <Setter Property="FontSize" Value="18" />
            </Style>

            <Style TargetType="{x:Type TextBlock}" x:Key="Protections">
                <Setter Property="FontSize" Value="{DynamicResource FontSize1}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily1}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <Style TargetType="{x:Type TextBlock}" x:Key="ItemEffects">
                <Setter Property="FontSize" Value="{DynamicResource FontSize1}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily1}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <Style TargetType="{x:Type TextBlock}" x:Key="EnemyList">
                <Setter Property="FontSize" Value="{DynamicResource FontSize1}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily1}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <Style TargetType="Label" x:Key="BuffTimerBig">
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBuff}" />
                <Setter Property="FontSize" Value="{DynamicResource FontSize3Big}" />
            </Style>
            <Style TargetType="Label" BasedOn="{StaticResource BuffTimerBig}" x:Key="BuffTimerSmall">
                <Setter Property="FontSize" Value="{DynamicResource FontSize3Small}" />
            </Style>

            <!-- OptionsControl's tabs (General/Twitch Integration) - the default Aero2 tab strip
                 is a light-themed Windows control and clashes with the dark parchment skin, so
                 this flattens it to a simple bordered header matching the rest of the UI (dark
                 #FF151313 borders, Segoe Print) instead of pulling in system theme chrome. -->
            <Style TargetType="{x:Type TabItem}">
                <Setter Property="FontFamily" Value="Segoe Print" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Border x:Name="Border" BorderBrush="#FF151313" BorderThickness="1,1,1,0" Margin="0,0,2,0" Padding="10,4">
                                <ContentPresenter x:Name="ContentSite" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#FFDDD3B8"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="False">
                                    <Setter TargetName="Border" Property="Background" Value="#88DDD3B8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type TabControl}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent"/>
                                <Border Grid.Row="1" BorderBrush="#FF151313" BorderThickness="1" Background="Transparent">
                                    <ContentPresenter ContentSource="SelectedContent"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
