<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>WPFFrontend.App.EntryPoint</StartupObject>
    <AssemblyName>BG Radar Overlay</AssemblyName>
    <DefineConstants Condition="'$(PublishSingleFile)' == 'true' and '$(Configuration)' == 'Release'">$(DefineConstants);RADAR_AUTOUPDATE</DefineConstants>
    <ApplicationIcon>ic.ico</ApplicationIcon>
    <PlatformTarget>X64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
	<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- This project only ever runs on Windows (WPF, WindowsDesktop SDK, System.Windows.Forms
         references for FontDialog/Screen), so CA1416 (platform compatibility) warnings on
         Windows-only APIs like Bitmap/Font are all false positives here. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>X64</PlatformTarget>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>X64</PlatformTarget>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="icons\not_found.png" />
    <None Remove="pexels-photo-235985.jpeg" />
    <None Remove="radar.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Properties\AssemblyVersionInfo.cs" Link="Properties\AssemblyVersionInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.39" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
    <PackageReference Include="WpfColorFontDialog" Version="1.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BGOverlay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms">
      <HintPath>C:\Program Files (x86)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8\System.Windows.Forms.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icons\not_found.png" />
    <Resource Include="icons\damage\*.png" />
    <Resource Include="icons\character\*.png" />
    <Resource Include="artwork\character-frame\*.png" />
    <Resource Include="artwork\character-dividers\*.png" />
    <Resource Include="artwork\enemy-list-parchment.png" />
    <Resource Include="pexels-photo-235985.jpeg" />
    <Resource Include="CombatText\Art\*.png;CombatText\Art\*.json" />
    <Resource Include="radar.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loose text files (not embedded resources) so translators/users can add or edit a
         locale without recompiling. ExcludeFromSingleFile keeps them out of the single-file
         exe bundle - without it, IncludeAllContentForSelfExtract above would embed them and
         self-extract to a temp cache directory on every run instead of leaving a real,
         editable Locales folder next to the published exe. -->
    <Content Include="Locales\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="Exists('..\bin\NativeRadar\BG2Radar.asi')">
    <RadarPayload Include="..\bin\NativeRadar\BG2Radar.asi;..\bin\NativeRadar\winmm*.dll" Link="GameFiles\%(Filename)%(Extension)" />
    <RadarPayload Include="..\bin\NativeRadar\*LICENSE*.txt" Link="GameFiles\license\%(Filename)%(Extension)" />
    <RadarPayload Include="..\EEexMod\M_RDRCRT.lua;..\EEexMod\M_RDRFT.lua;..\EEexMod\RDRFEATS.menu" Link="GameFiles\override\%(Filename)%(Extension)" />
    <Content Include="@(RadarPayload)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>
