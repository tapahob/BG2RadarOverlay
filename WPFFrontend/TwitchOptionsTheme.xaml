<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Ink" Color="#302015"/>
    <SolidColorBrush x:Key="FadedInk" Color="#574331"/>
    <SolidColorBrush x:Key="Rule" Color="#705037"/>
    <SolidColorBrush x:Key="Paper" Color="#40F4D6A3"/>
    <SolidColorBrush x:Key="Gold" Color="#F4DA9F"/>
    <SolidColorBrush x:Key="Leather" Color="#573821"/>

    <Style x:Key="Section" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Rule}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Background" Value="#24E2BE86"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,3,6,3"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource FadedInk}"/>
        <Setter Property="Margin" Value="0,2,0,4"/>
    </Style>
    <Style x:Key="Warning" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
        <Setter Property="Foreground" Value="#722B17"/>
    </Style>
    <Style x:Key="StatusLabel" TargetType="Label" BasedOn="{StaticResource BoldSmall}">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Padding" Value="0,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Leather}"/>
        <Setter Property="Foreground" Value="{StaticResource Gold}"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" BorderBrush="{StaticResource Ink}" BorderThickness="1"
                            Background="{TemplateBinding Background}">
                        <Border x:Name="Rim" BorderThickness="1" BorderBrush="#99815C" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="#735034"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Rim" Property="BorderBrush" Value="{StaticResource Gold}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Background" Value="#30583B22"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Rule}"/>
                            <Setter TargetName="Rim" Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource FadedInk}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
        <Setter Property="SelectionBrush" Value="#97703E"/>
        <Setter Property="Background" Value="{StaticResource Paper}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4,1"/>
        <Setter Property="MinHeight" Value="25"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" BorderBrush="{StaticResource Rule}" BorderThickness="1" Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Ink}"/>
                            <Setter TargetName="Frame" Property="Background" Value="#88F4D6A3"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Background" Value="#16583B22"/>
                            <Setter Property="Foreground" Value="{StaticResource FadedInk}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"
                                Background="{StaticResource Paper}" BorderBrush="{StaticResource Rule}" BorderThickness="1">
                            <Path x:Name="Check" Visibility="Hidden" Data="M 2,7 L 5.5,10.5 L 12,3"
                                  Stroke="{StaticResource Gold}" StrokeThickness="2"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Leather}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ink}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border BorderBrush="{StaticResource Rule}" BorderThickness="1" Background="{StaticResource Paper}">
                        <ScrollViewer Focusable="False" CanContentScroll="True">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="5,2">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#406B4A2B"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Leather}"/>
                            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Row" Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource FadedInk}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="IsSelected" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Row" Property="Background" Value="#386B4A2B"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Both the page and the pack list scroll vertically. Keep the track clickable
         for paging and leave thumb sizing and dragging to WPF. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="#3067472B" BorderThickness="1,0,0,0" BorderBrush="{StaticResource Rule}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                            <Track.Resources>
                                <Style TargetType="RepeatButton">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Track.Resources>
                            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Margin="2" Background="{StaticResource Leather}" BorderBrush="{StaticResource Rule}" BorderThickness="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
