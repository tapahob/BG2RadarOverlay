<UserControl x:Class="WPFFrontend.OptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPFFrontend"
             mc:Ignorable="d" Visibility="Collapsed" d:Visibility="Visible"
             Width="{DynamicResource OptionsControlWidth}"
             Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="5" Grid.RowSpan="5"
             VerticalAlignment="Top" HorizontalAlignment="Center" Panel.ZIndex="9000"
    xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero2">
    <UserControl.Background>
        <ImageBrush ImageSource="/pexels-photo-235985.jpeg" Stretch="UniformToFill"/>
    </UserControl.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
            <!-- Everything below the header used to be laid out directly in this Grid's own
                 rows/columns; it now all lives inside the TabControl below (each TabItem gets
                 its own nested Grid reproducing the original row heights), so a single Auto row
                 sized to whichever tab is selected replaces the old fixed-row stack. -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- The two content columns are Star-sized (not a fixed 180px) so they grow to fill
                 whatever width OptionsControlWidth resolves to for the active locale - a fixed
                 width here left unaccounted-for space on the right whenever a locale widened the
                 control past the original 395px (10+180+15+180+10) sum. -->
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <!-- Anchored to the Grid's actual top-right corner (Column 3+4 and Row 0 so Right/Top
             alignment reaches the real outer edges) instead of a fixed left/bottom offset from
             one interior cell, so it stays pinned to the corner with a constant 25px gap
             regardless of how wide OptionsControlWidth makes the (Star-sized) content columns
             for a given locale. -->
        <Label x:Name="CloseBtn" Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" Grid.ColumnSpan="2" Content="X" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Top" FontFamily="Segoe Print" Margin="0,15,25,0" MouseDown="Label_MouseDown"/>
        <Label Grid.Row="1" Grid.Column="1" FontSize="18" d:Content="Options" Content="{DynamicResource Str_Options}" FontFamily="Segoe Print" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30" Grid.RowSpan="2" Grid.ColumnSpan="3"/>
        <Label x:Name="Version" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" FontSize="10" d:Content="Ver. 2.0.3.2" Content="{Binding Configuration.Version}" FontFamily="Segoe Print" HorizontalAlignment="Center" Margin="0,26,0,30" Grid.RowSpan="2" Width="80"/>
        <Border Grid.RowSpan="4" Grid.ColumnSpan="5" BorderThickness="5" BorderBrush="#FF151313"/>

        <TabControl Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Background="Transparent" BorderThickness="0">
            <TabItem d:Header="General" Header="{DynamicResource Str_TabGeneral}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="145"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" BorderThickness="1" BorderBrush="#FF151313"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,5,5,5">
                        <Label Style="{StaticResource BoldSmall}" d:Content="Character List Filtering" Content="{DynamicResource Str_CharacterListFiltering}" HorizontalAlignment="Center"/>
                        <CheckBox x:Name="HidePartyMembers" d:Content="Hide Party Members" Content="{DynamicResource Str_HidePartyMembers}" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" />
                        <CheckBox x:Name="HideNeutrals" d:Content="Hide Neutrals" Content="{DynamicResource Str_HideNeutrals}" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold"/>
                        <CheckBox x:Name="HideAllies" VerticalContentAlignment="Center" d:Content="Hide Allies" Content="{DynamicResource Str_HideAllies}" FontFamily="Segoe Print" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Grid.Row="0" Grid.Column="3" BorderThickness="1" BorderBrush="#FF151313"/>
                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="5,5,5,5">
                        <Label d:Content="Buff Panel" Content="{DynamicResource Str_BuffPanel}" Style="{StaticResource BoldSmall}" HorizontalAlignment="Center"/>
                        <CheckBox x:Name="BigBuffIcons" VerticalContentAlignment="Center" d:Content="Big Buff icons" Content="{DynamicResource Str_BigBuffIcons}" FontFamily="Segoe Print" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Grid.ColumnSpan="3" Grid.Row="1" Grid.Column="1" BorderThickness="1" BorderBrush="#FF151313" Margin="0,16,0,0" Grid.RowSpan="2"/>
                    <StackPanel Grid.ColumnSpan="3" Grid.Row="2" Grid.Column="1" Margin="5,5,5,5">
                        <Label d:Content="Borderless Mode" Content="{DynamicResource Str_BorderlessMode}" Style="{StaticResource BoldSmall}" HorizontalAlignment="Center"/>
                        <CheckBox x:Name="EnableBorderlessMode" VerticalContentAlignment="Center" d:Content="Borderless on startup" Content="{DynamicResource Str_BorderlessOnStartup}" FontFamily="Segoe Print" FontWeight="Bold"/>
                        <Button x:Name="ForceBorderless" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" d:Content="Force Borderless now!" Content="{DynamicResource Str_ForceBorderlessNow}" FontFamily="Segoe Print" FontWeight="Bold" Click="ForceBorderless_Click"/>
                    </StackPanel>
                    <Border Grid.Row="3" Grid.ColumnSpan="1" Grid.Column="1" BorderThickness="1" BorderBrush="#FF151313" Margin="0,16,0,0" Grid.RowSpan="3"/>
                    <StackPanel Grid.ColumnSpan="1" Grid.Row="4" Grid.Column="1" Margin="5,5,5,5" Grid.RowSpan="2">
                        <Label d:Content="Performance" Content="{DynamicResource Str_Performance}" Style="{StaticResource BoldSmall}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <Label d:Content="Refresh Rate (ms):" Content="{DynamicResource Str_RefreshRate}" Style="{StaticResource BoldSmall}"/>
                            <TextBox x:Name="RefreshRate" PreviewTextInput="TextBox_PreviewTextInput" MinWidth="50" Text="100" BorderThickness="1" BorderBrush="#FF151313" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" Background="Transparent" Height="25" Width="46" Margin="-5" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Row="3" Grid.ColumnSpan="1" Grid.Column="3" BorderThickness="1" BorderBrush="#FF151313" Margin="0,16,0,0" Grid.RowSpan="3"/>
                    <StackPanel Grid.ColumnSpan="1" Grid.Row="4" Grid.Column="3" Margin="5,5,5,5" Grid.RowSpan="2">
                        <Label Style="{StaticResource BoldSmall}" HorizontalAlignment="Center" d:Content="Fonts" Content="{DynamicResource Str_Fonts}"/>
                        <Button Grid.ColumnSpan="3" Grid.Column="1" Grid.Row="9" x:Name="Font1" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" Content="Save" Click="SelectFont" Margin="3"/>
                        <Button Grid.ColumnSpan="3" Grid.Column="1" Grid.Row="9" x:Name="Font2" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" Content="Save" Click="SelectFont" Margin="3"/>
                        <Button Grid.ColumnSpan="3" Grid.Column="1" Grid.Row="9" x:Name="Font3" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" Content="Save" Click="SelectFont" Margin="3"/>
                    </StackPanel>
                    <Border Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" BorderThickness="1" BorderBrush="#FF151313"/>
                    <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Margin="5,5,5,5">
                        <Label d:Content="Other" Content="{DynamicResource Str_Other}" Style="{StaticResource BoldSmall}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Vertical">
                            <CheckBox x:Name="UseShiftClick" VerticalContentAlignment="Center" d:Content="Use Shift Click" Content="{DynamicResource Str_UseShiftClick}" ToolTip="{DynamicResource Str_UseShiftClickTooltip}" FontFamily="Segoe Print" FontWeight="Bold"/>
                            <CheckBox x:Name="DebugMode" VerticalContentAlignment="Center" d:Content="Debug Mode" Content="{DynamicResource Str_DebugMode}" FontFamily="Segoe Print" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal">
                                <Label d:Content="Locale:" Content="{DynamicResource Str_Locale}" Style="{StaticResource BoldSmall}" HorizontalAlignment="Center"/>
                                <ComboBox x:Name="Locale" Height="25" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="5, -5, 0, 0" d:SelectedItem="en_US" BorderThickness="1" BorderBrush="#FF151313" FontFamily="Segoe Print" FontWeight="Bold" Width="77">
                                    <d:ComboBoxItem Content="en_US" Height="23"/>
                                </ComboBox>
                                <!-- The radar's own UI text re-localizes live (MainWindow.ApplyLocalization),
                                     but game-text-derived names (creatures/items, read from the game's own
                                     lang/ folder) are cached at startup and only pick up a locale change on
                                     the next restart - make that explicit instead of leaving it a surprise. -->
                                <Label d:Content="Applies fully after Radar restart" Content="{DynamicResource Str_LocaleRestartNote}" Style="{StaticResource BoldSmall}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.ColumnSpan="3" Grid.Column="1" Grid.Row="8" x:Name="Save" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" d:Content="Save" Content="{DynamicResource Str_Save}" FontFamily="Segoe Print" FontWeight="Bold" Click="Save_Click" Margin="0,16,0,0" Grid.RowSpan="2"/>
                </Grid>
            </TabItem>
            <TabItem d:Header="Twitch Integration" Header="{DynamicResource Str_TabTwitchIntegration}">
                <StackPanel Margin="10" MinHeight="450">
                    <Label d:Content="Twitch Integration" Content="{DynamicResource Str_TwitchIntegration}" Style="{StaticResource BoldSmall}" HorizontalAlignment="Center"/>

                    <CheckBox x:Name="TwitchIntegrationEnabled" d:Content="Enable Twitch Integration" Content="{DynamicResource Str_TwitchEnable}" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" Margin="0,10,0,0"/>
                    <!-- EEex is a separate mod with its own installer, and the one prerequisite
                         the Install game files button below cannot provide. Without it the spawn
                         bridge errors out on load and every summon silently does nothing. -->
                    <TextBlock x:Name="EEexMissingWarning" Visibility="Collapsed" d:Visibility="Visible" Foreground="#FFD06A4A"
                               d:Text="EEex is not installed in the detected game folder - Twitch summons need it." Text="{DynamicResource Str_TwitchNeedsEEex}"
                               TextWrapping="Wrap" FontFamily="Segoe Print" FontWeight="Bold" FontSize="11" Margin="0,4,0,0"/>

                    <!-- Everything below only matters once integration is on - disabled as a
                         group whenever the checkbox above is unchecked, re-enabled the instant
                         it's checked again (see updateTwitchControlsEnabled in the code-behind). -->
                    <StackPanel x:Name="TwitchControlsPanel">
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Label d:Content="Relay Server URL:" Content="{DynamicResource Str_TwitchRelayUrl}" Style="{StaticResource BoldSmall}" VerticalAlignment="Center" Width="122"/>
                        <TextBox x:Name="TwitchRelayUrl" Width="220" d:Text="https://relay.example.com" BorderThickness="1" BorderBrush="#FF151313" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" Background="Transparent" Height="25"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Label d:Content="Twitch Channel:" Content="{DynamicResource Str_TwitchChannel}" Style="{StaticResource BoldSmall}" VerticalAlignment="Center" Width="122"/>
                        <TextBox x:Name="TwitchBroadcasterLogin" Width="180" d:Text="yunamaxwell" BorderThickness="1" BorderBrush="#FF151313" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" Background="Transparent" Height="25"/>
                    </StackPanel>
                    <TextBlock d:Text="Your channel's login (as in twitch.tv/&lt;this&gt;) - lets a relay shared by several streamers tell your stream key apart from theirs." Text="{DynamicResource Str_TwitchChannelHint}" TextWrapping="Wrap" FontFamily="Segoe Print" FontWeight="Bold" FontSize="11" Margin="122,2,0,0"/>
                    <!-- A display name typed in here instead of the login resolves to no account
                         at all, and the only symptom was summons failing at the relay with
                         nothing on this screen hinting why. -->
                    <TextBlock x:Name="TwitchChannelWarning" Visibility="Collapsed" d:Visibility="Visible" Foreground="#FFD06A4A"
                               d:Text="That doesn't look like a Twitch login - no spaces." Text="{DynamicResource Str_TwitchChannelInvalid}"
                               TextWrapping="Wrap" FontFamily="Segoe Print" FontWeight="Bold" FontSize="11" Margin="122,2,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Label d:Content="Stream Key:" Content="{DynamicResource Str_TwitchStreamKey}" Style="{StaticResource BoldSmall}" VerticalAlignment="Center" Width="122"/>
                        <TextBox x:Name="TwitchStreamKey" Width="150" d:Text="3f9a2c7e18b4400e9f5d6a1c2b3e4f50" IsReadOnly="True" BorderThickness="1" BorderBrush="#FF151313" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" Background="Transparent" Height="25"/>
                        <Button x:Name="GenerateStreamKey" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" d:Content="Connect" FontFamily="Segoe Print" FontWeight="Bold" Click="GenerateStreamKey_Click" Margin="5,0,0,0"/>
                        <!-- Only shown once a key exists, because the button beside it has become
                             Connect by then and rotating the key would otherwise be unreachable -
                             the key box is read-only, so there is no way to clear it by hand. -->
                        <Button x:Name="RegenerateStreamKey" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" d:Content="New Key" FontFamily="Segoe Print" FontWeight="Bold" Click="RegenerateStreamKey_Click" Margin="5,0,0,0"/>
                    </StackPanel>

                    <!-- Authorizes spawning creatures in-game - shown only in Debug Mode so it
                         isn't casually visible/streamable (see updateControlKeyVisibility). -->
                    <StackPanel x:Name="TwitchControlKeyRow" Orientation="Horizontal" Margin="0,10,0,0">
                        <Label d:Content="Control key:" Content="{DynamicResource Str_TwitchControlKey}" Style="{StaticResource BoldSmall}" VerticalAlignment="Center" Width="122"/>
                        <TextBox x:Name="TwitchControlKey" Width="180" d:Text="7c1e4b90fa2d4c8e8b6f3a9d0e1c2b4a" IsReadOnly="True" BorderThickness="1" BorderBrush="#FF151313" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" Background="Transparent" Height="25"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Label d:Content="Status:" Content="{DynamicResource Str_TwitchStatus}" Style="{StaticResource BoldSmall}" VerticalAlignment="Center" Width="122"/>
                        <Label x:Name="TwitchStatus" Style="{StaticResource BoldSmall}" VerticalAlignment="Center" d:Content="Connected"/>
                    </StackPanel>

                    <Label d:Content="Summon packs" Content="{DynamicResource Str_TwitchPacksSection}" Style="{StaticResource BoldSmall}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    <TextBlock d:Text="Packs viewers can pick from on stream. The name is what they see; the level range decides when a pack is offered. Requires EEex plus M_BG2RDR.lua in the game's override folder." Text="{DynamicResource Str_TwitchPacksHint}" TextWrapping="Wrap" FontFamily="Segoe Print" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>

                    <!-- Installs the game-side half of the bridge into the detected game's
                         override folder. EEex itself is a separate mod and is not installed
                         here - the status text beside the button says so. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="InstallEEexMod" d:Content="Install game files" Content="{DynamicResource Str_TwitchInstallMod}" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" FontFamily="Segoe Print" FontWeight="Bold" Click="InstallEEexMod_Click"/>
                        <Label x:Name="EEexModStatusLabel" Style="{StaticResource BoldSmall}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" d:Content="Installed"/>
                    </StackPanel>
                    <TextBlock x:Name="EEexModResult" TextWrapping="Wrap" FontFamily="Segoe Print" FontWeight="Bold" FontSize="11" Margin="0,0,0,6" d:Text="Copied 2 files into the game's override folder. Restart the game to load them."/>

                    <ListBox x:Name="PackList" Height="140" BorderThickness="1" BorderBrush="#FF151313" Background="Transparent" FontFamily="Segoe Print" FontWeight="Bold" FontSize="11" SelectionChanged="PackList_SelectionChanged">
                        <d:ListBox.ItemsSource>
                            <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                <sys:String>Gnoll Ambush (Lv 1-3, 50 tokens)</sys:String>
                                <sys:String>Ogre Warband (Lv 4-7, 120 tokens)</sys:String>
                                <sys:String>Vampire Trio (Lv 8-12, 300 tokens)</sys:String>
                            </x:Array>
                        </d:ListBox.ItemsSource>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Label d:Content="Name (shown to viewers):" Content="{DynamicResource Str_TwitchPackName}" Style="{StaticResource BoldSmall}" VerticalAlignment="Center" Width="122"/>
                        <TextBox x:Name="PackName" Width="170" MaxLength="24" d:Text="Gnoll Ambush" BorderThickness="1" BorderBrush="#FF151313" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" Background="Transparent" Height="25"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Label d:Content="Levels:" Content="{DynamicResource Str_TwitchPackLevels}" Style="{StaticResource BoldSmall}" VerticalAlignment="Center" Width="122"/>
                        <TextBox x:Name="PackLevelFrom" Width="40" Text="1" PreviewTextInput="TextBox_PreviewTextInput" BorderThickness="1" BorderBrush="#FF151313" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" Background="Transparent" Height="25"/>
                        <Label d:Content="to" Content="{DynamicResource Str_TwitchPackTo}" Style="{StaticResource BoldSmall}" VerticalAlignment="Center"/>
                        <TextBox x:Name="PackLevelTo" Width="40" Text="3" PreviewTextInput="TextBox_PreviewTextInput" BorderThickness="1" BorderBrush="#FF151313" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" Background="Transparent" Height="25"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Label d:Content="Summon cost:" Content="{DynamicResource Str_TwitchPackCost}" Style="{StaticResource BoldSmall}" VerticalAlignment="Center" Width="122"/>
                        <TextBox x:Name="PackCost" Width="70" Text="0" PreviewTextInput="TextBox_PreviewTextInput" BorderThickness="1" BorderBrush="#FF151313" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" Background="Transparent" Height="25"/>
                        <Label d:Content="tokens (0 = free)" Content="{DynamicResource Str_TwitchPackCostUnit}" Style="{StaticResource BoldSmall}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Label d:Content="Creatures (one &quot;RESREF amount&quot; per line):" Content="{DynamicResource Str_TwitchPackCreatures}" Style="{StaticResource BoldSmall}" Margin="0,6,0,0"/>
                    <TextBox x:Name="PackEntries" Height="60" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" d:Text="GNOLL01&#x0a;GNOLL02&#x0a;GNOLL03" BorderThickness="1" BorderBrush="#FF151313" FontFamily="Segoe Print" FontWeight="Bold" Background="Transparent"/>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="PackSave" IsEnabled="False" d:Content="Save pack" Content="{DynamicResource Str_TwitchPackSave}" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" FontFamily="Segoe Print" FontWeight="Bold" Click="PackSave_Click"/>
                        <Button x:Name="PackDelete" IsEnabled="False" d:Content="Delete" Content="{DynamicResource Str_TwitchPackDelete}" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" FontFamily="Segoe Print" FontWeight="Bold" Click="PackDelete_Click" Margin="5,0,0,0"/>
                        <Button x:Name="PackNew" d:Content="New" Content="{DynamicResource Str_TwitchPackNew}" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" FontFamily="Segoe Print" FontWeight="Bold" Click="PackNew_Click" Margin="5,0,0,0"/>
                        <Button x:Name="TestSummon" IsEnabled="False" d:Content="Test summon" Content="{DynamicResource Str_TwitchSummonButton}" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" FontFamily="Segoe Print" FontWeight="Bold" Click="TestSummon_Click" Margin="5,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="SummonResult" TextWrapping="Wrap" FontFamily="Segoe Print" FontWeight="Bold" FontSize="11" Margin="0,6,0,0" d:Text="Queued: Gnoll Ambush (Lv 1-3)"/>
                    </StackPanel>

                    <Button x:Name="SaveTwitch" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" d:Content="Save" Content="{DynamicResource Str_Save}" FontFamily="Segoe Print" FontWeight="Bold" Click="Save_Click" Margin="0,20,0,0" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </TabItem>
            <TabItem d:Header="Diagnostics" Header="{DynamicResource Str_TabDiagnostics}">
                <!-- Read-only readout of CycleProfiler, refreshed on a DispatcherTimer while
                     this control is visible (same pattern as the Twitch status label). Values
                     are set from code rather than bound, so there is nothing for the profiler
                     to push onto the UI thread from the loop it is measuring. -->
                <Grid Margin="0,8,0,35">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="1" BorderThickness="1" BorderBrush="#FF151313"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,5,5,5">
                        <Label Style="{StaticResource BoldSmall}" HorizontalAlignment="Center" d:Content="One iteration (ms)" Content="{DynamicResource Str_DiagIteration}"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="1" Style="{StaticResource BoldSmall}" FontSize="10" HorizontalAlignment="Right" d:Content="Last" Content="{DynamicResource Str_DiagLast}"/>
                            <Label Grid.Row="0" Grid.Column="2" Style="{StaticResource BoldSmall}" FontSize="10" HorizontalAlignment="Right" d:Content="Avg" Content="{DynamicResource Str_DiagAvg}"/>
                            <Label Grid.Row="0" Grid.Column="3" Style="{StaticResource BoldSmall}" FontSize="10" HorizontalAlignment="Right" d:Content="95th" Content="{DynamicResource Str_DiagP95}"/>
                            <Label Grid.Row="0" Grid.Column="4" Style="{StaticResource BoldSmall}" FontSize="10" HorizontalAlignment="Right" d:Content="Max" Content="{DynamicResource Str_DiagMax}"/>

                            <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource BoldSmall}" FontSize="11" d:Content="Cycle" Content="{DynamicResource Str_DiagCycle}"/>
                            <Label x:Name="DiagCycleLast" Grid.Row="1" Grid.Column="1" FontFamily="Segoe Print" FontSize="11" HorizontalAlignment="Right" d:Content="356.2"/>
                            <Label x:Name="DiagCycleAvg" Grid.Row="1" Grid.Column="2" FontFamily="Segoe Print" FontSize="11" HorizontalAlignment="Right" d:Content="354.8"/>
                            <Label x:Name="DiagCycleP95" Grid.Row="1" Grid.Column="3" FontFamily="Segoe Print" FontSize="11" HorizontalAlignment="Right" d:Content="381.0"/>
                            <Label x:Name="DiagCycleMax" Grid.Row="1" Grid.Column="4" FontFamily="Segoe Print" FontSize="11" HorizontalAlignment="Right" d:Content="470.3"/>

                            <Label Grid.Row="2" Grid.Column="0" Style="{StaticResource BoldSmall}" FontSize="11" d:Content="Work" Content="{DynamicResource Str_DiagWork}"/>
                            <Label x:Name="DiagWorkLast" Grid.Row="2" Grid.Column="1" FontFamily="Segoe Print" FontSize="11" HorizontalAlignment="Right" d:Content="49.1"/>
                            <Label x:Name="DiagWorkAvg" Grid.Row="2" Grid.Column="2" FontFamily="Segoe Print" FontSize="11" HorizontalAlignment="Right" d:Content="47.6"/>
                            <Label x:Name="DiagWorkP95" Grid.Row="2" Grid.Column="3" FontFamily="Segoe Print" FontSize="11" HorizontalAlignment="Right" d:Content="72.4"/>
                            <Label x:Name="DiagWorkMax" Grid.Row="2" Grid.Column="4" FontFamily="Segoe Print" FontSize="11" HorizontalAlignment="Right" d:Content="163.9"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="2" Grid.Column="1" BorderThickness="1" BorderBrush="#FF151313"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="5,5,5,5">
                        <Label Style="{StaticResource BoldSmall}" HorizontalAlignment="Center" d:Content="Where the time goes (avg ms)" Content="{DynamicResource Str_DiagBreakdown}"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="0.55*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="0.55*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource BoldSmall}" FontSize="11" d:Content="Memory scan" Content="{DynamicResource Str_DiagPhaseScan}"/>
                            <Label x:Name="DiagScan" Grid.Row="0" Grid.Column="1" FontFamily="Segoe Print" FontSize="11" HorizontalAlignment="Right" d:Content="38.4"/>
                            <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource BoldSmall}" FontSize="11" d:Content="Pool prune" Content="{DynamicResource Str_DiagPhasePrune}"/>
                            <Label x:Name="DiagPrune" Grid.Row="1" Grid.Column="1" FontFamily="Segoe Print" FontSize="11" HorizontalAlignment="Right" d:Content="0.2"/>
                            <Label Grid.Row="2" Grid.Column="0" Style="{StaticResource BoldSmall}" FontSize="11" d:Content="Filter + sort" Content="{DynamicResource Str_DiagPhaseFilter}"/>
                            <Label x:Name="DiagFilter" Grid.Row="2" Grid.Column="1" FontFamily="Segoe Print" FontSize="11" HorizontalAlignment="Right" d:Content="1.1"/>

                            <Label Grid.Row="0" Grid.Column="2" Style="{StaticResource BoldSmall}" FontSize="11" d:Content="Twitch" Content="{DynamicResource Str_DiagPhaseTwitch}"/>
                            <Label x:Name="DiagTwitch" Grid.Row="0" Grid.Column="3" FontFamily="Segoe Print" FontSize="11" HorizontalAlignment="Right" d:Content="0.0"/>
                            <Label Grid.Row="1" Grid.Column="2" Style="{StaticResource BoldSmall}" FontSize="11" d:Content="UI update" Content="{DynamicResource Str_DiagPhaseUi}"/>
                            <Label x:Name="DiagUi" Grid.Row="1" Grid.Column="3" FontFamily="Segoe Print" FontSize="11" HorizontalAlignment="Right" d:Content="7.9"/>
                            <Label Grid.Row="2" Grid.Column="2" Style="{StaticResource BoldSmall}" FontSize="11" d:Content="Sleep" Content="{DynamicResource Str_DiagPhaseSleep}"/>
                            <Label x:Name="DiagSleep" Grid.Row="2" Grid.Column="3" FontFamily="Segoe Print" FontSize="11" HorizontalAlignment="Right" d:Content="307.2"/>

                            <!-- The memory scan interleaves three different jobs slot by slot, so
                                 they accumulate within it rather than splitting it into phases. -->
                            <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Style="{StaticResource BoldSmall}" FontSize="10" Opacity="0.75" d:Content="memory scan, of which:" Content="{DynamicResource Str_DiagOfWhich}"/>
                            <Label Grid.Row="4" Grid.Column="0" Style="{StaticResource BoldSmall}" FontSize="11" Margin="12,0,0,0" d:Content="Slot array" Content="{DynamicResource Str_DiagSlotArray}"/>
                            <Label x:Name="DiagSlotRead" Grid.Row="4" Grid.Column="1" FontFamily="Segoe Print" FontSize="11" HorizontalAlignment="Right" d:Content="2.1"/>
                            <Label Grid.Row="4" Grid.Column="2" Style="{StaticResource BoldSmall}" FontSize="11" d:Content="Refresh" Content="{DynamicResource Str_DiagRefreshPhase}"/>
                            <Label x:Name="DiagRefresh" Grid.Row="4" Grid.Column="3" FontFamily="Segoe Print" FontSize="11" HorizontalAlignment="Right" d:Content="8.4"/>
                            <Label Grid.Row="5" Grid.Column="0" Style="{StaticResource BoldSmall}" FontSize="11" Margin="12,0,0,0" d:Content="Build new" Content="{DynamicResource Str_DiagBuildPhase}"/>
                            <Label x:Name="DiagBuild" Grid.Row="5" Grid.Column="1" FontFamily="Segoe Print" FontSize="11" HorizontalAlignment="Right" d:Content="0.9"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="4" Grid.Column="1" BorderThickness="1" BorderBrush="#FF151313"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="5,5,5,5">
                        <Label Style="{StaticResource BoldSmall}" HorizontalAlignment="Center" d:Content="Cost" Content="{DynamicResource Str_DiagCost}"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource BoldSmall}" FontSize="11" d:Content="Busy" Content="{DynamicResource Str_DiagBusy}"/>
                            <Label x:Name="DiagBusy" Grid.Row="0" Grid.Column="1" FontFamily="Segoe Print" FontSize="11" d:Content="13.4% of one core"/>
                            <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource BoldSmall}" FontSize="11" d:Content="Real rate" Content="{DynamicResource Str_DiagRealRate}"/>
                            <Label x:Name="DiagRate" Grid.Row="1" Grid.Column="1" FontFamily="Segoe Print" FontSize="11" d:Content="2.82 Hz (set: 3.33)"/>
                            <Label Grid.Row="2" Grid.Column="0" Style="{StaticResource BoldSmall}" FontSize="11" d:Content="Entities" Content="{DynamicResource Str_DiagEntities}"/>
                            <Label x:Name="DiagEntities" Grid.Row="2" Grid.Column="1" FontFamily="Segoe Print" FontSize="11" d:Content="47 slots, 2 new, 45 kept"/>
                            <Label Grid.Row="3" Grid.Column="0" Style="{StaticResource BoldSmall}" FontSize="11" d:Content="Window" Content="{DynamicResource Str_DiagWindow}"/>
                            <Label x:Name="DiagWindow" Grid.Row="3" Grid.Column="1" FontFamily="Segoe Print" FontSize="11" d:Content="128 cycles"/>
                        </Grid>
                    </StackPanel>

                    <Button x:Name="DiagReset" Grid.Row="6" Grid.Column="1" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313"
                            d:Content="Reset measurements" Content="{DynamicResource Str_DiagReset}" FontFamily="Segoe Print" FontWeight="Bold" Click="DiagReset_Click"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
