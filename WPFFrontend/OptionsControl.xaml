<UserControl x:Class="WPFFrontend.OptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPFFrontend"
             mc:Ignorable="d" Visibility="Collapsed" d:Visibility="Visible"
             Width="{DynamicResource OptionsControlWidth}"
             Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="5" Grid.RowSpan="5"
             VerticalAlignment="Top" HorizontalAlignment="Center" Panel.ZIndex="9000"
    xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero2">
    <UserControl.Background>
        <ImageBrush ImageSource="/pexels-photo-235985.jpeg" Stretch="UniformToFill"/>
    </UserControl.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
            <!-- Everything below the header used to be laid out directly in this Grid's own
                 rows/columns; it now all lives inside the TabControl below (each TabItem gets
                 its own nested Grid reproducing the original row heights), so a single Auto row
                 sized to whichever tab is selected replaces the old fixed-row stack. -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- The two content columns are Star-sized (not a fixed 180px) so they grow to fill
                 whatever width OptionsControlWidth resolves to for the active locale - a fixed
                 width here left unaccounted-for space on the right whenever a locale widened the
                 control past the original 395px (10+180+15+180+10) sum. -->
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <!-- Anchored to the Grid's actual top-right corner (Column 3+4 and Row 0 so Right/Top
             alignment reaches the real outer edges) instead of a fixed left/bottom offset from
             one interior cell, so it stays pinned to the corner with a constant 25px gap
             regardless of how wide OptionsControlWidth makes the (Star-sized) content columns
             for a given locale. -->
        <Label x:Name="CloseBtn" Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" Grid.ColumnSpan="2" Content="X" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Top" FontFamily="Segoe Print" Margin="0,15,25,0" MouseDown="Label_MouseDown"/>
        <Label Grid.Row="1" Grid.Column="1" FontSize="18" Content="{DynamicResource Str_Options}" FontFamily="Segoe Print" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30" Grid.RowSpan="2" Grid.ColumnSpan="3"/>
        <Label x:Name="Version" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" FontSize="10" d:Content="Ver. 2.0.3.2" Content="{Binding Configuration.Version}" FontFamily="Segoe Print" HorizontalAlignment="Center" Margin="0,26,0,30" Grid.RowSpan="2" Width="80"/>
        <Border Grid.RowSpan="4" Grid.ColumnSpan="5" BorderThickness="5" BorderBrush="#FF151313"/>

        <TabControl Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Background="Transparent" BorderThickness="0">
            <TabItem Header="{DynamicResource Str_TabGeneral}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="145"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" BorderThickness="1" BorderBrush="#FF151313"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,5,5,5">
                        <Label Style="{StaticResource BoldSmall}" Content="{DynamicResource Str_CharacterListFiltering}" HorizontalAlignment="Center"/>
                        <CheckBox x:Name="HidePartyMembers" Content="{DynamicResource Str_HidePartyMembers}" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" />
                        <CheckBox x:Name="HideNeutrals" Content="{DynamicResource Str_HideNeutrals}" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold"/>
                        <CheckBox x:Name="HideAllies" VerticalContentAlignment="Center" Content="{DynamicResource Str_HideAllies}" FontFamily="Segoe Print" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Grid.Row="0" Grid.Column="3" BorderThickness="1" BorderBrush="#FF151313"/>
                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="5,5,5,5">
                        <Label Content="{DynamicResource Str_BuffPanel}" Style="{StaticResource BoldSmall}" HorizontalAlignment="Center"/>
                        <CheckBox x:Name="BigBuffIcons" VerticalContentAlignment="Center" Content="{DynamicResource Str_BigBuffIcons}" FontFamily="Segoe Print" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Grid.ColumnSpan="3" Grid.Row="1" Grid.Column="1" BorderThickness="1" BorderBrush="#FF151313" Margin="0,16,0,0" Grid.RowSpan="2"/>
                    <StackPanel Grid.ColumnSpan="3" Grid.Row="2" Grid.Column="1" Margin="5,5,5,5">
                        <Label Content="{DynamicResource Str_BorderlessMode}" Style="{StaticResource BoldSmall}" HorizontalAlignment="Center"/>
                        <CheckBox x:Name="EnableBorderlessMode" VerticalContentAlignment="Center" Content="{DynamicResource Str_BorderlessOnStartup}" FontFamily="Segoe Print" FontWeight="Bold"/>
                        <Button x:Name="ForceBorderless" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" Content="{DynamicResource Str_ForceBorderlessNow}" FontFamily="Segoe Print" FontWeight="Bold" Click="ForceBorderless_Click"/>
                    </StackPanel>
                    <Border Grid.Row="3" Grid.ColumnSpan="1" Grid.Column="1" BorderThickness="1" BorderBrush="#FF151313" Margin="0,16,0,0" Grid.RowSpan="3"/>
                    <StackPanel Grid.ColumnSpan="1" Grid.Row="4" Grid.Column="1" Margin="5,5,5,5" Grid.RowSpan="2">
                        <Label Content="{DynamicResource Str_Performance}" Style="{StaticResource BoldSmall}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{DynamicResource Str_RefreshRate}" Style="{StaticResource BoldSmall}"/>
                            <TextBox x:Name="RefreshRate" PreviewTextInput="TextBox_PreviewTextInput" MinWidth="50" Text="300" BorderThickness="1" BorderBrush="#FF151313" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" Background="Transparent" Height="25" Width="46" Margin="-5" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Row="3" Grid.ColumnSpan="1" Grid.Column="3" BorderThickness="1" BorderBrush="#FF151313" Margin="0,16,0,0" Grid.RowSpan="3"/>
                    <StackPanel Grid.ColumnSpan="1" Grid.Row="4" Grid.Column="3" Margin="5,5,5,5" Grid.RowSpan="2">
                        <Label Style="{StaticResource BoldSmall}" HorizontalAlignment="Center" Content="{DynamicResource Str_Fonts}"/>
                        <Button Grid.ColumnSpan="3" Grid.Column="1" Grid.Row="9" x:Name="Font1" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" Content="Save" Click="SelectFont" Margin="3"/>
                        <Button Grid.ColumnSpan="3" Grid.Column="1" Grid.Row="9" x:Name="Font2" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" Content="Save" Click="SelectFont" Margin="3"/>
                        <Button Grid.ColumnSpan="3" Grid.Column="1" Grid.Row="9" x:Name="Font3" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" Content="Save" Click="SelectFont" Margin="3"/>
                    </StackPanel>
                    <Border Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" BorderThickness="1" BorderBrush="#FF151313"/>
                    <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Margin="5,5,5,5">
                        <Label Content="{DynamicResource Str_Other}" Style="{StaticResource BoldSmall}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Vertical">
                            <CheckBox x:Name="UseShiftClick" VerticalContentAlignment="Center" Content="{DynamicResource Str_UseShiftClick}" ToolTip="{DynamicResource Str_UseShiftClickTooltip}" FontFamily="Segoe Print" FontWeight="Bold"/>
                            <CheckBox x:Name="DebugMode" VerticalContentAlignment="Center" Content="{DynamicResource Str_DebugMode}" FontFamily="Segoe Print" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal">
                                <Label Content="{DynamicResource Str_Locale}" Style="{StaticResource BoldSmall}" HorizontalAlignment="Center"/>
                                <ComboBox x:Name="Locale" Height="25" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="5, -5, 0, 0" d:SelectedItem="en_US" BorderThickness="1" BorderBrush="#FF151313" FontFamily="Segoe Print" FontWeight="Bold" Width="77">
                                    <d:ComboBoxItem Content="en_US" Height="23"/>
                                </ComboBox>
                                <!-- The radar's own UI text re-localizes live (MainWindow.ApplyLocalization),
                                     but game-text-derived names (creatures/items, read from the game's own
                                     lang/ folder) are cached at startup and only pick up a locale change on
                                     the next restart - make that explicit instead of leaving it a surprise. -->
                                <Label Content="{DynamicResource Str_LocaleRestartNote}" Style="{StaticResource BoldSmall}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.ColumnSpan="3" Grid.Column="1" Grid.Row="8" x:Name="Save" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" Content="{DynamicResource Str_Save}" FontFamily="Segoe Print" FontWeight="Bold" Click="Save_Click" Margin="0,16,0,0" Grid.RowSpan="2"/>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Str_TabTwitchIntegration}">
                <StackPanel Margin="10" MinHeight="450">
                    <Label Content="{DynamicResource Str_TwitchIntegration}" Style="{StaticResource BoldSmall}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Str_TwitchIntegrationComingSoon}" TextWrapping="Wrap" FontFamily="Segoe Print" FontWeight="Bold" Margin="0,10,0,10"/>

                    <CheckBox x:Name="TwitchIntegrationEnabled" Content="{DynamicResource Str_TwitchEnable}" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" Margin="0,10,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Label Content="{DynamicResource Str_TwitchRelayUrl}" Style="{StaticResource BoldSmall}" VerticalAlignment="Center" Width="122"/>
                        <TextBox x:Name="TwitchRelayUrl" Width="220" BorderThickness="1" BorderBrush="#FF151313" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" Background="Transparent" Height="25"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Label Content="{DynamicResource Str_TwitchStreamKey}" Style="{StaticResource BoldSmall}" VerticalAlignment="Center" Width="122"/>
                        <TextBox x:Name="TwitchStreamKey" Width="180" IsReadOnly="True" BorderThickness="1" BorderBrush="#FF151313" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" Background="Transparent" Height="25"/>
                        <Button x:Name="GenerateStreamKey" Content="{DynamicResource Str_TwitchGenerateKey}" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" FontFamily="Segoe Print" FontWeight="Bold" Click="GenerateStreamKey_Click" Margin="5,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Label Content="{DynamicResource Str_TwitchControlKey}" Style="{StaticResource BoldSmall}" VerticalAlignment="Center" Width="122"/>
                        <TextBox x:Name="TwitchControlKey" Width="180" IsReadOnly="True" BorderThickness="1" BorderBrush="#FF151313" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" Background="Transparent" Height="25"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Str_TwitchControlKeyHint}" TextWrapping="Wrap" FontFamily="Segoe Print" FontWeight="Bold" FontSize="11" Margin="122,2,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Label Content="{DynamicResource Str_TwitchStatus}" Style="{StaticResource BoldSmall}" VerticalAlignment="Center" Width="122"/>
                        <Label x:Name="TwitchStatus" Style="{StaticResource BoldSmall}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Label Content="{DynamicResource Str_TwitchPacksSection}" Style="{StaticResource BoldSmall}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    <TextBlock Text="{DynamicResource Str_TwitchPacksHint}" TextWrapping="Wrap" FontFamily="Segoe Print" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>

                    <ListBox x:Name="PackList" Height="70" BorderThickness="1" BorderBrush="#FF151313" Background="Transparent" FontFamily="Segoe Print" FontWeight="Bold" FontSize="11" SelectionChanged="PackList_SelectionChanged"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Label Content="{DynamicResource Str_TwitchPackName}" Style="{StaticResource BoldSmall}" VerticalAlignment="Center" Width="122"/>
                        <TextBox x:Name="PackName" Width="170" MaxLength="24" BorderThickness="1" BorderBrush="#FF151313" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" Background="Transparent" Height="25"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Label Content="{DynamicResource Str_TwitchPackLevels}" Style="{StaticResource BoldSmall}" VerticalAlignment="Center" Width="122"/>
                        <TextBox x:Name="PackLevelFrom" Width="40" Text="1" PreviewTextInput="TextBox_PreviewTextInput" BorderThickness="1" BorderBrush="#FF151313" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" Background="Transparent" Height="25"/>
                        <Label Content="{DynamicResource Str_TwitchPackTo}" Style="{StaticResource BoldSmall}" VerticalAlignment="Center"/>
                        <TextBox x:Name="PackLevelTo" Width="40" Text="3" PreviewTextInput="TextBox_PreviewTextInput" BorderThickness="1" BorderBrush="#FF151313" VerticalContentAlignment="Center" FontFamily="Segoe Print" FontWeight="Bold" Background="Transparent" Height="25"/>
                    </StackPanel>

                    <Label Content="{DynamicResource Str_TwitchPackCreatures}" Style="{StaticResource BoldSmall}" Margin="0,6,0,0"/>
                    <TextBox x:Name="PackEntries" Height="60" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" BorderThickness="1" BorderBrush="#FF151313" FontFamily="Segoe Print" FontWeight="Bold" Background="Transparent"/>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="PackSave" IsEnabled="False" Content="{DynamicResource Str_TwitchPackSave}" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" FontFamily="Segoe Print" FontWeight="Bold" Click="PackSave_Click"/>
                        <Button x:Name="PackDelete" IsEnabled="False" Content="{DynamicResource Str_TwitchPackDelete}" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" FontFamily="Segoe Print" FontWeight="Bold" Click="PackDelete_Click" Margin="5,0,0,0"/>
                        <Button x:Name="PackNew" Content="{DynamicResource Str_TwitchPackNew}" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" FontFamily="Segoe Print" FontWeight="Bold" Click="PackNew_Click" Margin="5,0,0,0"/>
                        <Button x:Name="TestSummon" IsEnabled="False" Content="{DynamicResource Str_TwitchSummonButton}" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" FontFamily="Segoe Print" FontWeight="Bold" Click="TestSummon_Click" Margin="5,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="SummonResult" TextWrapping="Wrap" FontFamily="Segoe Print" FontWeight="Bold" FontSize="11" Margin="0,6,0,0"/>

                    <Button x:Name="SaveTwitch" BorderThickness="1" Background="Transparent" BorderBrush="#FF151313" Content="{DynamicResource Str_Save}" FontFamily="Segoe Print" FontWeight="Bold" Click="Save_Click" Margin="0,20,0,0" HorizontalAlignment="Left" Width="120"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
